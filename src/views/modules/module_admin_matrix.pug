include module_permission_fields

//- views/mixins/admin-matrix.pug
//- Admin Manager (entity-level per-user permissions)
//- Params:
//-   admins:   Array<{ profileId:string, profile:Profile, perms:number }>
//-   permMeta: Array<{ key:string, bit:number, label:string, desc?:string }>
//-   presets:  Array<{ key:string, label:string, mask:number }>  (optional)
//-   opts?: {
//-     title?: string,
//-     apiAdd: string,       // POST   /api/{entity}/{id}/admins
//-     apiUpdate: string,    // PATCH  /api/{entity}/{id}/admins/{userId}
//-     apiRemove: string,    // DELETE /api/{entity}/{id}/admins/{userId}
//-     apiSearch?: string,   // GET    /api/users/search?q=...  (optional for typeahead)
//-     openFirst?: boolean
//-     inline?: boolean     // use a collapse inside the entity dialog, never a nested modal
//-   }

mixin adminMatrix(admins, permMeta, presets=[], opts)
    - const title = opts?.title ?? 'Administrators'
    - const accId = 'admin-acc-' + Math.random().toString(36).slice(2)
    - const openFirst = opts?.openFirst ?? false

    .admin-matrix.text-bg-dark#adminMatrix(
        data-api-add=opts.apiAdd
        data-api-update=opts.apiUpdate
        data-api-remove=opts.apiRemove
        data-api-search=opts.apiSearch || ''
    )
        //- Header row
        .d-flex.align-items-center.justify-content-between.mb-2
            .d-flex.align-items-center.gap-2
                i.bi.bi-shield-lock(aria-hidden="true")
                strong= title
                span.badge.bg-secondary.ms-1= (admins && admins.length) ? admins.length : 0
            button.btn.btn-sm.btn-primary.btn-admin-add(type="button" data-bs-toggle=opts.inline ? 'collapse' : 'modal' data-bs-target=`#${accId}-add-modal`)
                i.bi.bi-person-plus.me-1(aria-hidden="true")
                | Add

        //- Accordion
        .accordion.accordion-flush(id=accId)
            if !admins || !admins.length
                .text-secondary.small.ms-1.mb-2 No administrators yet.
            else
                each a, idx in admins
                    - const headId = `${accId}-head-${a.profileId}`
                    - const colId  = `${accId}-col-${a.profileId}`
                    - const profile = a.profile
                    .accordion-item.bg-dark.border-secondary.admin-card(data-user-id=a.profileId data-entity-section=opts.inline ? 'administrator' : undefined)
                        h2.accordion-header(id=headId)
                            button.accordion-button.text-light.bg-dark(class=(openFirst && idx === 0) ? '' : 'collapsed'
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target=`#${colId}`
                                aria-controls=colId
                                aria-expanded=(openFirst && idx === 0 ? 'true' : 'false'))
                                //- avatar (initials)
                                -
                                    let initials = '';
                                    for (const word of (profile.name || '??').split(/\s+/)) initials += word.charAt(0);
                                    initials = initials.slice(0, 2).toUpperCase();
                                .rounded-circle.bg-secondary.text-dark.d-inline-flex.justify-content-center.align-items-center.me-2(style="width:24px;height:24px;font-size:12px;")= initials
                                span.me-2= profile.name || ('#' + a.profileId)
                                //- compact badge: number of enabled perms
                                -
                                    let enabled = 0;
                                    for (const permission of permMeta) if (a.perms & permission.bit) enabled++;
                                span.badge.bg-secondary.ms-2= `${enabled}/${permMeta.length}`

                        .accordion-collapse.collapse(id=colId data-bs-parent=`#${accId}` class=(openFirst && idx === 0) ? 'show' : '')
                            .accordion-body.bg-dark.pt-2
                                if opts.inline
                                    div(data-command-feedback aria-live="polite")
                                //- Shared grouping preserves exactly the same keys, masks, and
                                //- preset behavior used by audience defaults in the adjacent view.
                                +permissionToolbar(presets, a.profileId, true)
                                +permissionFields(permMeta, a.perms || 0, `admin-${a.profileId}`)

                                //- Actions
                                .d-flex.justify-content-between.mt-3
                                    button.btn.btn-outline-danger.btn-sm.btn-admin-remove(type="button" data-user-id=a.profileId)
                                        i.bi.bi-trash.me-1(aria-hidden="true")
                                        | Remove
                                    button.btn.btn-primary.btn-sm.btn-admin-update(type="button" data-user-id=a.profileId)
                                        span.label Save
                                        span.spinner-border.spinner-border-sm.ms-2.d-none(role="status" aria-hidden="true")

        //- The same add form can be hosted inline in Entity settings or in its original modal.
        //- Stable IDs and data-modal keep one browser handler; only presentation/focus hosting differs.
        div(id=`${accId}-add-modal` class=opts.inline ? 'collapse admin-inline' : 'modal admin-modal fade' tabindex=opts.inline ? undefined : '-1' aria-labelledby=`${accId}-add-title` aria-hidden=opts.inline ? undefined : 'true' data-entity-section=opts.inline ? 'administrator-add' : undefined)
            div(class=opts.inline ? 'mt-3' : 'modal-dialog modal-dialog-centered')
                .bg-dark.text-light.border.border-secondary(class=opts.inline ? 'rounded p-3' : 'modal-content')
                    div(class=opts.inline ? 'mb-2' : 'modal-header')
                        h5.modal-title(id=`${accId}-add-title`) Add administrator
                        if !opts.inline
                            button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Close")
                    div(class=opts.inline ? undefined : 'modal-body')
                        div(data-command-feedback aria-live="polite")
                        form(id=`${accId}-add-form`)
                            .mb-3
                                label.form-label(for=`${accId}-search`)
                                    i.bi.bi-search.me-1(aria-hidden="true")
                                    | User (name or email)
                                input.form-control.text-bg-dark(id=`${accId}-search` type="text" placeholder="Search user..." list=`${accId}-datalist`)
                                datalist(id=`${accId}-datalist`)
                                input(type="hidden" id=`${accId}-userId`)
                                small.text-secondary.d-block Use search results to select a user.
                            if presets && presets.length
                                .mb-2
                                    label.form-label(for=`${accId}-preset`)
                                        i.bi.bi-magic.me-1(aria-hidden="true")
                                        | Initial preset
                                    select.form-select.text-bg-dark(id=`${accId}-preset`)
                                        option(value="") None
                                        each pr in presets
                                            option(value=pr.key)= pr.label
                    div(class=opts.inline ? 'd-flex justify-content-end gap-2' : 'modal-footer')
                        button.btn.btn-outline-secondary(type="button" data-bs-dismiss=opts.inline ? undefined : 'modal' data-admin-cancel=opts.inline ? `#${accId}-add-modal` : undefined) Cancel
                        button.btn.btn-primary.btn-admin-add-submit(type="button" data-modal=`#${accId}-add-modal`)
                            span.label Add
                            span.spinner-border.spinner-border-sm.ms-2.d-none(role="status" aria-hidden="true")

    script(type="module").
        import { initAdminMatrix } from "/js/modules/admin-matrix.gen.js";
        initAdminMatrix();
