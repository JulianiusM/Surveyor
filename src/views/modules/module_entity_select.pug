//- Shared event selection content. Every DOM hook is prefixed by id; the browser module owns
//- filtering and result navigation but changes the hidden selection only after an explicit choice.
//- This mixin renders no form or modal, allowing creation and entity settings to share it safely.
mixin entityPickerContent(id, opts)
    .entity-picker-content(id=id + '-content')
        .row.g-2.align-items-end.mb-2
            .col
                label.form-label(for=id + '-search') Search events
                input.form-control.text-bg-dark(id=id + '-search' type='search' placeholder='Search by title or description…' autocomplete='off' aria-controls=id + '-list')
            .col-auto
                button.btn.btn-sm.btn-outline-secondary(type='button' id=id + '-reset') Reset filters
        //- Advanced filters stay available without pushing the event choices below the fold.
        details.border.border-secondary.rounded.p-2.mb-2
            summary.small Filter by dates and state
            .row.g-2.mt-1
                .col-sm-6
                    label.form-label.small(for=id + '-from') From
                    input.form-control.form-control-sm.text-bg-dark(id=id + '-from' type='date')
                .col-sm-6
                    label.form-label.small(for=id + '-to') To
                    input.form-control.form-control-sm.text-bg-dark(id=id + '-to' type='date')
                .col-sm-4
                    label.form-label.small(for=id + '-period') Period
                    select.form-select.form-select-sm.text-bg-dark(id=id + '-period')
                        option(value='all') All
                        option(value='upcoming') Upcoming
                        option(value='ongoing') Ongoing
                        option(value='ended') Ended
                .col-sm-4
                    label.form-label.small(for=id + '-archive') Archive state
                    select.form-select.form-select-sm.text-bg-dark(id=id + '-archive')
                        option(value='all') All
                        option(value='active') Active
                        option(value='archived') Archived
                .col-sm-4
                    label.form-label.small(for=id + '-deadline') Registration deadline
                    select.form-select.form-select-sm.text-bg-dark(id=id + '-deadline')
                        option(value='all') All
                        option(value='open') Not passed / no deadline
                        option(value='passed') Passed
        .d-flex.flex-wrap.gap-2.align-items-center.mb-2
            if !opts.required
                button.btn.btn-sm.btn-outline-light(type='button' id=id + '-clear' aria-pressed='false') No event
            //- Selected state remains visible when the selected event is outside the current page.
            p.small.mb-0(id=id + '-selection' role='status')
        p.small.text-info.d-none(id=id + '-archive-hint') Archived with selected event. Existing access and actions remain available.
        p.small.text-danger.d-none(id=id + '-error' aria-live='assertive')
        p.small.text-secondary.d-none(id=id + '-loading' role='status') Loading events…
        ul.list-group.list-group-flush.text-bg-dark.overflow-auto(id=id + '-list' aria-label='Available events' aria-describedby=id + '-summary' style='max-height: 22rem')
        p.small.text-secondary.mt-2.mb-2(id=id + '-summary' aria-live='polite')
        .d-flex.gap-2
            button.btn.btn-sm.btn-outline-light.d-none(type='button' id=id + '-previous') Previous page
            button.btn.btn-sm.btn-outline-light.d-none(type='button' id=id + '-more') Next page
            button.btn.btn-sm.btn-outline-secondary.d-none(type='button' id=id + '-retry') Try again

//- name is the submitted hidden field; entities contains authorized seeds, normally the current event.
//- opts follows EntityPickerOptions. mode='inline' embeds content without creating a nested modal.
//- Existing creation calls retain their API and use the authorized collection endpoint by default.
mixin entityPicker(name, entities, opts)
    -
        const options = opts || {};
        const id = options.id || name;
        const inline = options.mode === 'inline';
        const pickerOptions = Object.assign({endpoint: name === 'event_id' ? '/api/event/link-options' : null}, options);
        const initialValue = options.value == null ? '' : String(options.value);
        const initialOptions = Array.isArray(entities) ? entities : [];
        let initialLabel = initialValue ? 'Current event' : (options.placeholderLabel || 'No event');
        for (const entity of initialOptions) {
            if (String(entity.id) === initialValue && entity.title) initialLabel = entity.title;
        }
        // Escaping '<' prevents a stored title/description from closing the inline module script.
        const serializedId = JSON.stringify(id).replace(/</g, '\\u003c');
        const serializedEntities = JSON.stringify(initialOptions).replace(/</g, '\\u003c');
        const serializedOptions = JSON.stringify(pickerOptions).replace(/</g, '\\u003c');

    .entity-picker(class=options.class id=id + '-picker')
        if options.label
            if inline
                p.form-label= options.label
            else
                label.form-label(for=id + '-btn')= options.label
        input(type='hidden' name=name id=id value=initialValue required=options.required)
        if inline
            +entityPickerContent(id, options)
        else
            button.btn.btn-outline-light.w-100.text-start(type='button' id=id + '-btn' data-bs-toggle='modal' data-bs-target='#' + id + '-modal')
                i.bi.bi-calendar-event.me-2(aria-hidden='true')
                span(id=id + '-btn-label')= initialLabel
            .modal.fade(id=id + '-modal' tabindex='-1' aria-labelledby=id + '-modal-label' aria-hidden='true')
                .modal-dialog.modal-lg.modal-dialog-scrollable
                    .modal-content.text-bg-dark
                        .modal-header
                            h5.modal-title(id=id + '-modal-label') Choose an event
                            button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
                        .modal-body
                            +entityPickerContent(id, options)
                        .modal-footer
                            button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
        if options.help
            .form-text.mt-1= options.help
    script(type='module').
        import { initEntitySelect } from "/js/modules/entity-select.gen.js";
        initEntitySelect(!{serializedId}, !{serializedEntities}, !{serializedOptions});
