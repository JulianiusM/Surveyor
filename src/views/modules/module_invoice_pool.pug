                p.fw-semibold= ui.text('currentShareRowsAndAllRecordedPaymentsAreKept')
                p.text-secondary.small= ui.text('changesToEventAttendanceRegistrationsOrInvoicesAreNot')
                .pool-form-status(role="status" aria-live="polite" tabindex="-1")
                .d-flex.justify-content-end.flex-wrap.gap-2.mt-3
                    button.btn.btn-secondary(type="button" data-bs-dismiss="modal")= ui.text('cancel')
                    button.btn.btn-outline-light.pool-return(type="button" data-id=pool.id hidden)= ui.text('returnToPool')
                    button.btn.btn-warning.pool-rollback(type="button" data-id=pool.id disabled=!pool.calculationSnapshot)= ui.text('restoreLastCalculatedSettings')

mixin invoicePoolManageTab(ev, pools, participants, ui)
    if pools && pools.length
        p.text-secondary.small.mb-3= ui.text('openAPoolToReviewInvoicesAndSettlementUse')
        .accordion.accordion-dark#invoicePoolAccordion
            each pool in pools
                +poolManagementSection(ev, pool, participants, ui)
        each pool in pools
            +poolManagementModals(ev, pool, participants, ui)
    else
        p.text-secondary.mb-0= ui.text('noInvoicePoolsCreatedYet')

//- Shared distribution selector to keep create/edit forms in sync
mixin poolDistributionSelect(name, selected, id = null, ui)
    select.form-select.text-bg-dark(name=name id=id required)
        option(value="TIME_BASED" selected=selected === 'TIME_BASED')= ui.text('distributeAmongDaysAttended')
        option(value="NIGHTS" selected=selected === 'NIGHTS')= ui.text('distributeAmongNightsStayed')
        option(value="EQUAL" selected=selected === 'EQUAL')= ui.text('distributeAmongParticipants')

//- Shared base settings fields used for pool creation and later edits
mixin poolBaseSettingsFields(pool = {}, ui)
    - const selectedDistribution = pool.distributionMethod || pool.distribution || 'TIME_BASED';
    .row.g-3
        .col-md-6
            label.form-label(for=pool.id ? `poolDistribution-${pool.id}` : "poolDistribution")= ui.text('shareDistributionMode')
            +poolDistributionSelect('distribution', selectedDistribution, pool.id ? `poolDistribution-${pool.id}` : "poolDistribution", ui)
        .col-md-6
            label.form-label(for=pool.id ? `poolDescription-${pool.id}` : "poolDescription")= ui.text('description')
            input.form-control.text-bg-dark(
                type="text"
                name="description"
                id=pool.id ? `poolDescription-${pool.id}` : "poolDescription"
                value=pool.description || ''
            )
        .col-12
            input(type="hidden" name="roundUpSharesConfigured" value="on")
            .form-check.form-switch
                input.form-check-input(type="checkbox" name="roundUpShares" id=pool.id ? `pool-${pool.id}-rounding` : "poolRoundingCreate" checked=pool.roundUpShares == null || !!pool.roundUpShares)
                label.form-check-label(for=pool.id ? `pool-${pool.id}-rounding` : "poolRoundingCreate")= ui.text('roundBaseSharesUp')
            p.text-secondary.small.mt-2.mb-0= ui.text('selectedRoundEachBaseShareUpToTheNext')

//- Compact editable form for the base pool parameters
mixin poolBaseSettingsForm(ev, pool, ui)
    form.pool-base-form(data-api=`/api/event/${ev.id}/invoice-pools/${pool.id}` data-pool=pool.id data-pool-status=pool.status)
        +poolSaveNotice(pool, ui)
        +poolBaseSettingsFields(pool, ui)
        input(type="hidden" name="sendCalculationEmailsConfigured" value="on")
        .form-check.form-switch.mt-3
            input.form-check-input(type="checkbox" name="sendCalculationEmails" id=`pool-${pool.id}-email-default` checked=pool.sendCalculationEmails == null || !!pool.sendCalculationEmails)
            label.form-check-label(for=`pool-${pool.id}-email-default`)= ui.text('sendCalculationEmailsAutomatically')
        p.text-secondary.small.mt-2= ui.text('useThisAsTheDefaultWhenClosingOrRecalculating')
        +poolFormFooter(ui.text('savePoolSettings'), ui)

//- Pool creation tab content for the admin dashboard
mixin invoicePoolCreateModal(ev, participants, ui)
    .modal.fade#poolCreateModal(tabindex="-1" aria-labelledby="poolCreateLabel" aria-hidden="true")
        .modal-dialog.modal-lg.modal-dialog-scrollable.modal-fullscreen-sm-down
            .modal-content.bg-dark.text-white
                .modal-header
                    h5.modal-title#poolCreateLabel= ui.text('createANewPool')
                    button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label=ui.text('close'))
                form.pool-modal-form#poolCreateForm(data-api=`/api/event/${ev.id}/invoice-pools`)
                    .modal-body
                        .row.g-3
                            .col-md-12
                                label.form-label(for="poolName")= ui.text('poolName2')
                                input#poolName.form-control.text-bg-dark(type="text" name="name" required maxlength="255")
                            .col-md-12
                                //- Initial status is part of the creation draft, so organizer-only pools are never briefly OPEN.
                                //- Editing this select saves nothing until Add pool; later changes use the confirmed state action.
                                label.form-label(for="poolSubmissionStateCreate")= ui.text('poolSubmissionState')
                                select#poolSubmissionStateCreate.form-select.text-bg-dark(name="status" required)
                                    option(value="OPEN" selected)= ui.text('openForInvoices')
                                    option(value="ORGANIZER_ONLY")= ui.text('organizerInvoicesOnly')
                                p.text-secondary.small.mt-2.mb-0= ui.text('poolSubmissionStateHelp')
                        .row.g-3.mt-0
                            .col-md-8
                                +poolBaseSettingsFields({}, ui)
                            .col-md-4
                                label.form-label.text-secondary= ui.text('allocation')
                                .form-check
                                    input#assignAllPools.form-check-input.pool-toggle(type="checkbox" name="assignAll" checked)
                                    label.form-check-label(for="assignAllPools")= ui.text('assignToAllParticipants')
                                .form-check
                                    input#defaultPool.form-check-input.pool-toggle(type="checkbox" name="isDefault")
                                    label.form-check-label(for="defaultPool")= ui.text('makeThisTheDefaultPool')
                                small.text-secondary= ui.text('defaultPoolsAutomaticallyIncludeFutureParticipantsWithoutReopeningAssignments')
                                .form-check.mt-2
                                    input#subtractPersonalInvoicesCreate.form-check-input(type="checkbox" name="subtractPersonalInvoices" checked)
                                    label.form-check-label(for="subtractPersonalInvoicesCreate")= ui.text('deductSubmitterInvoicesFromTheirShare')
                            .col-12
                                label.form-label(for="poolRegistrations")= ui.text('limitToParticipantsDisabledWhenAssignedToAll')
                                .assignments-list.border.border-secondary-subtle.rounded-3.p-2.bg-black.text-white#poolRegistrations
                                    if participants && participants.length
                                        each p in participants
                                            .form-check
                                                input.form-check-input(type="checkbox" name="registrations" value=p.id id=`pool-create-reg-${p.id}` disabled checked)
                                                label.form-check-label(for=`pool-create-reg-${p.id}`)= ui.text('nameAndEmail', {name: p.name, email: p.email})
                                    else
                                        p.text-secondary.small.mb-0= ui.text('noParticipantsYet')
                        .pool-form-status.mt-3(role="status" aria-live="polite")
                    .modal-footer
                        button.btn.btn-secondary(type="button" data-bs-dismiss="modal")= ui.text('cancel')
                        button.btn.btn-primary(type="submit")
                            i.bi.bi-plus-circle.me-1(aria-hidden="true")
                            = ui.text('addPool')

//- Wrapper to tie together the manage and create tabs
mixin invoiceManagementTabs(ev, data)
    - const ui = data.invoiceUi;
    .card.mb-3.bg-dark.text-white.border-secondary-subtle
        .card-header.py-2.d-flex.flex-wrap.align-items-center.justify-content-between.gap-2
            .d-flex.align-items-center.gap-2
                i.bi.bi-receipt(aria-hidden="true")
                span= ui.text('invoicePools')
            button.btn.btn-primary.btn-sm(type="button" data-bs-toggle="modal" data-bs-target="#poolCreateModal")
                i.bi.bi-plus-circle.me-1(aria-hidden="true")
                = ui.text('createPool')
        .card-body
            +invoicePoolManageTab(ev, data.invoicePools, data.participants || [], data.invoiceUi)
    +invoicePoolCreateModal(ev, data.participants || [], ui)
    +invoiceOrganizerActionDialogs(ui)
    +invoiceCommandConfirmation(ui)

mixin invoiceActionDialog(id, title, ui)
    .modal.fade.pool-edit-modal(id=id tabindex="-1" aria-labelledby=`${id}-title` aria-hidden="true")
        .modal-dialog.modal-lg.modal-dialog-scrollable.modal-fullscreen-sm-down
            .modal-content.bg-dark.text-white
                .modal-header
                    h5.modal-title(id=`${id}-title`)= title
                    button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label=ui.text('close'))
                block

//- Shared organizer correction/rejection dialogs receive captured invoice context from browser hooks.
//- Their final review preserves the established confirmed/revision API contract; ui supplies every dialog string.
mixin invoiceOrganizerActionDialogs(ui)
    +invoiceActionDialog("invoiceEditModal", ui.text('correctInvoice'), ui)
        form.pool-modal-form.invoice-lifecycle-form(data-action="revise")
            .modal-body
                p.fw-semibold(data-invoice-change-subject)
                p.small.text-secondary= ui.text('correctTheEffectiveAmountOrDescriptionTheOriginalInvoice')
                .mb-3
                    label.form-label(for="invoiceEditAmount")= ui.text('amount')
                    input#invoiceEditAmount.form-control.text-bg-dark(type="number" name="correctedAmount" min="0.01" max="99999999.99" step="0.01" required)
                .mb-3
                    label.form-label(for="invoiceEditDescription")= ui.text('description')
                    textarea#invoiceEditDescription.form-control.text-bg-dark(name="correctedDescription" rows="3" maxlength="4000")
                    small.text-secondary= ui.text('leaveThisEmptyToRestoreTheOriginalDescription')
                .pool-form-status(role="status" aria-live="polite")
            .modal-footer
                button.btn.btn-secondary(type="button" data-bs-dismiss="modal")= ui.text('cancel')
                button.btn.btn-primary(type="submit")= ui.text('continue')
    +invoiceActionDialog("invoiceRejectModal", ui.text('rejectInvoiceFromPool'), ui)
        form.pool-modal-form.invoice-lifecycle-form(data-action="reject-accepted")
            .modal-body
                p.fw-semibold(data-invoice-change-subject)
                p.small.text-secondary= ui.text('rejectingRemovesThisAcceptedCostFromThePoolTotal')
                label.form-label(for="invoiceRejectReason")= ui.text('rejectionReason')
                textarea#invoiceRejectReason.form-control.text-bg-dark(name="rejectionReason" rows="3" maxlength="4000" required)
                .pool-form-status.mt-3(role="status" aria-live="polite")
            .modal-footer
                button.btn.btn-secondary(type="button" data-bs-dismiss="modal")= ui.text('cancel')
                button.btn.btn-danger(type="submit")= ui.text('continue')
    +invoiceActionDialog("invoiceConfirmModal", ui.text('confirmInvoiceChange'), ui)
        .modal-body
            p.fw-semibold(data-invoice-change-subject)
            div(data-invoice-change-review)
            p.text-warning.small(data-invoice-closed-warning hidden)= ui.text('existingSharesAndPaymentsStayUnchangedRecalculateThisClosed')
            p.small.text-secondary= ui.text('theChangeIsSavedOnlyAfterYouConfirmBelow')
            .pool-form-status(role="status" aria-live="polite")
        .modal-footer
            button.btn.btn-secondary.invoice-confirm-back(type="button")= ui.text('backToEdit')
            button.btn.btn-warning.invoice-confirm-submit(type="button")= ui.text('confirmChange')

mixin invoiceRetractionDialog(ui)
    +invoiceActionDialog("invoiceRetractModal", ui.text('retractInvoice'), ui)
        .modal-body
            p.fw-semibold(data-invoice-change-subject)
            p(data-invoice-retract-description)
            p= ui.text('thisInvoiceWillBeMarkedRetractedAndWillNo')
            .pool-form-status(role="status" aria-live="polite")
        .modal-footer
            button.btn.btn-secondary(type="button" data-bs-dismiss="modal")= ui.text('cancel')
            button.btn.btn-danger.invoice-retract-confirm(type="button")= ui.text('confirmRetraction')

//- Shared takeover modal for admins/participants with a search field
mixin takeoverModal(id, ui)
    .modal.fade.pool-edit-modal(id=id tabindex="-1" aria-labelledby=`${id}-title` aria-hidden="true")
        .modal-dialog.modal-lg.modal-dialog-scrollable.modal-fullscreen-sm-down
            .modal-content.bg-dark.text-white
                .modal-header
                    h5.modal-title(id=`${id}-title` data-takeover-title)= ui.text('manageTakeovers2')
                    button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label=ui.text('close'))
                form.pool-modal-form#takeoverForm
                    .modal-body
                        p.text-secondary.small= ui.text('chooseAPayerThenTheParticipantsTheyWillCover')
                        .status-notice.alert-info.small(data-takeover-status hidden)
                        .pool-takeover-selection.border.border-secondary-subtle.rounded-3.p-3.mb-3
                            strong.d-block= ui.text('selectedCoverage')
                            span.text-secondary.small(data-takeover-summary role="status" aria-live="polite")= ui.text('chooseAPayerToManageCoverage')
                        .pool-form-status(role="status" aria-live="polite" tabindex="-1")
                        .mb-3.admin-only
                            label.form-label(for="takeoverPayer")= ui.text('payer')
                            select#takeoverPayer.form-select.text-bg-dark(name="payerId")
                        .mb-3
                            label.form-label(for="takeoverSearch")= ui.text('searchParticipants')
                            input#takeoverSearch.form-control.text-bg-dark.takeover-search(type="search" placeholder=ui.text('typeToFilter'))
                        .takeover-beneficiaries.list-group.list-group-flush.bg-dark.border.border-secondary-subtle.rounded-3
                            // populated by JS
                    .modal-footer
                        button.btn.btn-secondary(type="button" data-bs-dismiss="modal")= ui.text('close')
                        button.btn.btn-primary(type="submit")
                            i.bi.bi-save.me-1(aria-hidden="true")
                            = ui.text('saveChanges')


//- Frontend-only review gate for otherwise immediate commands. Its handlers capture the existing
//- request before opening; Cancel, Escape, backdrop dismissal, and touch scrolling never execute it.
mixin invoiceCommandConfirmation(ui)
    +invoiceActionDialog("invoiceCommandConfirmModal", ui.text('confirmInvoiceAction'), ui)
        .modal-body
            p.fw-semibold(data-invoice-command-subject)
            p(data-invoice-command-description)
            .pool-form-status(role="status" aria-live="polite")
        .modal-footer
            button.btn.btn-secondary(type="button" data-bs-dismiss="modal" data-invoice-command-cancel)= ui.text('cancel')
            button.btn.btn-warning(type="button" data-invoice-command-confirm)= ui.text('confirm')
