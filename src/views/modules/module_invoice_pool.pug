//- Group saved pool.takeovers by payer using participants for names and ui for complete messages.
//- mode/registrationId mark personal coverage; data-takeover-* hooks page whole groups without changing coverage.
mixin poolCoverageOverview(pool, participants, mode, ui, registrationId = null)
    -
        const participantNames = new Map((participants || []).map(p => [p.id, p.name]));
        // Keep each payer’s coverage together; the explicitly passed actor ID only decorates personal rows.
        const coverageByPayer = new Map();
        for (const takeover of pool.takeovers || []) {
            const id = takeover.payerRegistrationId;
            if (!coverageByPayer.has(id)) coverageByPayer.set(id, {id, name: participantNames.get(id) || ui.text('participant', {id: id}), beneficiaries: []});
            coverageByPayer.get(id).beneficiaries.push({id: takeover.beneficiaryRegistrationId, name: participantNames.get(takeover.beneficiaryRegistrationId) || ui.text('participant', {id: takeover.beneficiaryRegistrationId})});
        }
        // Stable name sorting affects display only; the browser pages complete payer groups.
        const coverageGroups = [...coverageByPayer.values()].sort((a, b) => a.name.localeCompare(b.name));
        for (const group of coverageGroups) group.beneficiaries.sort((a, b) => a.name.localeCompare(b.name));
        const currentRegistrationId = mode === 'participant' ? registrationId : null;
    - const coverageId = `pool-${pool.id}-coverage-${mode}`
    .pool-takeover-summary.w-100(data-takeover-overview)
        if coverageGroups.length
            .d-flex.align-items-center.flex-wrap.justify-content-between.gap-2.mb-2
                small.text-secondary= ui.text('coverageCounts', {payers: ui.text('coveringPayersCount', {count: coverageGroups.length}), participants: ui.text('coveredParticipantsCount', {count: (pool.takeovers || []).length})})
            .takeover-overview-controls.d-flex.flex-wrap.gap-2.mb-2
                input.form-control.form-control-sm.text-bg-dark(id=`${coverageId}-search` type="search" data-takeover-overview-search placeholder=ui.text('findAPayerOrCoveredParticipant') aria-label=ui.text('searchTakeovers'))
                select.form-select.form-select-sm.text-bg-dark(data-takeover-page-size aria-label=ui.text('takeoverPayersPerPage'))
                    option(value="10")= ui.text('pageSizeOption', {count: 10})
                    option(value="25")= ui.text('pageSizeOption', {count: 25})
                    option(value="50")= ui.text('pageSizeOption', {count: 50})
            .table-responsive.pool-takeover-table
                table.table.table-dark.table-striped.table-bordered.align-middle.mb-0
                    caption.visually-hidden= ui.text('payersAndTheParticipantsWhoseSharesTheyCover')
                    thead
                        tr
                            th(scope="col")= ui.text('payer')
                            th(scope="col")= ui.text('coveredParticipants')
                            if mode === 'admin'
                                th(scope="col")= ui.text('actions')
                    tbody
                        each group in coverageGroups
                            - const beneficiaryListId = `${coverageId}-payer-${group.id}`
                            tr(data-takeover-overview-row data-payer-name=group.name data-search-text=`${group.name} ${group.beneficiaries.map(p => p.name).join(' ')}`.toLowerCase())
                                th.fw-normal(scope="row" data-label=ui.text('payer'))
                                    strong= group.name
                                    if currentRegistrationId === group.id
                                        span.badge.bg-info.text-dark.ms-2= ui.text('you')
                                    small.text-secondary.d-block.mt-1= ui.text('participantsCovered', {count: group.beneficiaries.length})
                                td(data-label=ui.text('coveredParticipants'))
                                    .takeover-beneficiary-chips.d-flex.flex-wrap.align-content-start.gap-1(id=beneficiaryListId data-takeover-beneficiaries tabindex="0" role="group" aria-label=ui.text('participantsCoveredBy', {name: group.name}))
                                        each beneficiary in group.beneficiaries
                                            span.badge.coverage-name-chip(data-takeover-beneficiary data-beneficiary-name=beneficiary.name class=currentRegistrationId === beneficiary.id ? 'bg-info text-dark' : 'bg-secondary')
                                                = beneficiary.name
                                                if currentRegistrationId === beneficiary.id
                                                    = ui.text('you2')
                                    .d-flex.flex-wrap.align-items-center.gap-2.mt-2(data-takeover-beneficiary-controls hidden)
                                        small.text-secondary(data-takeover-beneficiary-summary role="status" aria-live="polite")
                                        button.btn.btn-outline-light.btn-sm(type="button" data-takeover-expand aria-expanded="false" aria-controls=beneficiaryListId hidden)= ui.text('showAllCovered', {count: group.beneficiaries.length})
                                if mode === 'admin'
                                    td(data-label=ui.text('actions'))
                                        button.btn.btn-outline-light.btn-sm.manage-takeovers(type="button" data-id=pool.id data-payer=group.id data-mode="admin" aria-label=ui.text('editTakeoversFor', {name: group.name}))
                                            i.bi.bi-pencil.me-1(aria-hidden="true")
                                            = ui.text('edit')
            p.text-secondary.small.py-3.mb-0(hidden data-takeover-empty)= ui.text('noTakeoversMatchThisSearch')
            .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mt-2
                small.text-secondary(data-takeover-page-summary role="status" aria-live="polite")
                .btn-group.btn-group-sm(role="group" aria-label=ui.text('takeoverPages'))
                    button.btn.btn-outline-light(type="button" data-takeover-previous)= ui.text('previous2')
                    button.btn.btn-outline-light(type="button" data-takeover-next)= ui.text('next')
        else
            p.text-secondary.small.mb-0= ui.text('eachParticipantCoversTheirOwnShareUseManageTakeovers')
        if pool.needsRecalculation
            p.text-warning.small.mt-2.mb-0= ui.text('theseSavedTakeoversApplyAfterRecalculationPreviousShareNotes')

mixin poolTakeoverSummary(pool, participants, ui)
    //- Compare saved versus draft pairs once; legacy missing evidence cannot establish a pending difference.
    - const hasPendingTakeovers = ui.hasPendingTakeovers(pool);
    .border.border-secondary-subtle.rounded-3.p-3.mt-3
        h6.mb-2= ui.text('takeovers')
        //- Applied coverage is read-only in calculated pools. The chooser still edits current allocation inputs.
        if pool.status === 'CLOSED'
            if !ui.hasAppliedTakeoverEvidence(pool)
                p.text-secondary.small.mb-0= ui.text('appliedTakeoversUnavailable')
            else
                +poolCoverageOverview({...pool, takeovers: ui.appliedTakeovers(pool), needsRecalculation: false}, participants, 'applied', ui)
            //- Unknown historical coverage cannot establish a pending delta. Still expose editable future inputs
            //- under their own heading so older pools can be repaired through preview and recalculation.
            if !ui.hasAppliedTakeoverEvidence(pool) || hasPendingTakeovers
                h6.mt-3.mb-2= ui.text(ui.hasAppliedTakeoverEvidence(pool) ? 'pendingTakeoverChanges' : 'takeoversForNextCalculation')
                if hasPendingTakeovers
                    //- The warning belongs to the editable draft, while the read-only list above remains authoritative.
                    .status-notice.alert-warning.mb-3(role="status" data-pool-takeover-pending)
                        strong.d-block= ui.text('takeoverChangesPendingIndicator')
                        small= ui.text('takeoverChangesPendingDescription')
                +poolCoverageOverview(pool, participants, 'admin', ui)
        else
            +poolCoverageOverview(pool, participants, 'admin', ui)

