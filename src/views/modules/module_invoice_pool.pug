//- Common invoice pool fragments reused by admin and participant pages
include mixins/helpers.pug
//- Render calculated shares and their current settlement state.
mixin invoiceShareTable(pool, participants, admin = false, eventId = null)
    if pool.shares && pool.shares.length
        .share-ledger.border.border-secondary-subtle.rounded-3.p-3(data-share-ledger)
            .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-3
                .d-flex.align-items-center.flex-wrap.gap-2
                    strong Calculated shares
                    span.badge.bg-secondary #{pool.shares.length} payers
                if admin && eventId
                    a.btn.btn-outline-light.btn-sm(href=`/event/${eventId}/export/invoice-pools/${pool.id}/shares` download)
                        i.bi.bi-file-earmark-pdf.me-1(aria-hidden="true")
                        | Export as PDF
            .share-ledger-controls.d-flex.flex-wrap.gap-2.mb-3
                input.form-control.form-control-sm.text-bg-dark(type="search" placeholder="Search payers or calculation notes" aria-label="Search shares" data-share-search)
                select.form-select.form-select-sm.text-bg-dark(aria-label="Filter share status" data-share-filter)
                    option(value="") All statuses
                    option(value="due") Due
                    option(value="refund") Refund
                    option(value="settled") Settled
                select.form-select.form-select-sm.text-bg-dark(aria-label="Sort shares" data-share-sort)
                    option(value="name") Payer A–Z
                    option(value="amount-desc") Amount: high to low
                    option(value="amount-asc") Amount: low to high
                select.form-select.form-select-sm.text-bg-dark(aria-label="Shares per page" data-share-page-size)
                    option(value="25") 25 per page
                    option(value="50") 50 per page
                    option(value="100") 100 per page
            .table-responsive.share-ledger-table
                table.table.table-dark.table-hover.align-middle.mb-0
                    caption.visually-hidden Calculated payer shares and settlement status
                    thead
                        tr
                            th(scope="col") Payer
                            th(scope="col") Calculated balance
                            th(scope="col") Status
                            th(scope="col") Calculation details
                            th(scope="col") Paid
                    tbody(data-share-body)
                        each share in pool.shares
                            -
                                const registrationId = share.registrationId || share.registration?.id;
                                const payerName = (participants || []).find(pt => pt.id === registrationId)?.name || `Participant #${registrationId}`;
                                const covered = pool.needsRecalculation ? 'See saved calculation notes' : (pool.takeovers || [])
                                    .filter(t => t.payerRegistrationId === registrationId)
                                    .map(t => (participants || []).find(pt => pt.id === t.beneficiaryRegistrationId)?.name || `Participant #${t.beneficiaryRegistrationId}`)
                                    .join(', ');
                                const coveredCount = (pool.takeovers || []).filter(t => t.payerRegistrationId === registrationId).length;
                                const notes = (share.note || '').split(' • ').filter(Boolean);
                                const isPaid = share.isPaid === true || share.isPaid === 1;
                                const amount = Number(share.shareAmount);
                                const shareStatus = isPaid || amount === 0 ? 'settled' : amount < 0 ? 'refund' : 'due';
                                const searchText = `${payerName} ${covered} ${share.note || ''}`.toLowerCase();
                            tr(data-share-row data-share-name=payerName data-share-search=searchText data-share-amount=amount data-share-status=shareStatus)
                                td(data-label="Payer")
                                    strong.d-block #{payerName}
                                    small.text-secondary #{pool.needsRecalculation ? 'Coverage in saved notes' : coveredCount ? `Covers ${coveredCount} other participant${coveredCount === 1 ? '' : 's'}` : 'Own share'}
                                td(data-label="Calculated balance")
                                    strong.fs-5 #{fmtMoney(share.shareAmount)}
                                    small.d-block.text-secondary(data-share-balance-note) #{isPaid ? 'Already settled' : amount < 0 ? 'Amount to pay out' : amount > 0 ? 'Amount to collect' : 'No payment due'}
                                td(data-label="Status")
                                    span.badge(data-share-state class=shareStatus === 'settled' ? 'bg-success' : shareStatus === 'refund' ? 'bg-info text-dark' : 'bg-warning text-dark') #{shareStatus === 'settled' ? 'Settled' : shareStatus === 'refund' ? 'Refund' : 'Due'}
                                td(data-label="Calculation details")
                                    button.btn.btn-outline-light.btn-sm.share-details-open(type="button" data-bs-toggle="modal" data-bs-target=`#pool-${pool.id}-share-breakdown` aria-label=`View breakdown for ${payerName}`)
                                        i.bi.bi-calculator.me-1(aria-hidden="true")
                                        | View breakdown
                                    template(data-share-details)
                                        dl.row.g-1.small.mt-2.mb-2
                                            dt.col-7 Base
                                            dd.col-5.text-end #{fmtMoney(share.baseShareAmount)}
                                            dt.col-7 Adjustments
                                            dd.col-5.text-end #{fmtMoney(share.extraAmount)}
                                            dt.col-7 Invoice credit
                                            dd.col-5.text-end #{fmtMoney(share.invoiceCreditAmount)}
                                            dt.col-7 Previously settled
                                            dd.col-5.text-end #{fmtMoney(share.paymentCreditAmount)}
                                            dt.col-7 Calculated balance
                                            dd.col-5.text-end #{fmtMoney(share.shareAmount)}
                                        if covered && !pool.needsRecalculation
                                            details.small.mb-2
                                                summary.text-info Covered participants (#{coveredCount})
                                                p.text-secondary.mt-2.mb-0= covered
                                        if notes.length
                                            ul.small.ps-3.mb-0
                                                each note in notes
                                                    li.text-secondary= note
                                td(data-label="Paid")
                                    .form-check.form-switch
                                        input.form-check-input.share-paid(type="checkbox" data-pool=pool.id data-id=share.id data-amount=share.shareAmount data-paid=isPaid ? 'true' : 'false' checked=isPaid disabled=!admin autocomplete="off" aria-label=`Mark ${payerName} paid`)
            p.text-secondary.small.mb-0.py-3.text-center(hidden data-share-empty) No shares match these filters.
            .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mt-3
                small.text-secondary(data-share-page-summary role="status" aria-live="polite")
                button.btn.btn-outline-light.btn-sm(type="button" data-share-refresh) Refresh list
                .btn-group.btn-group-sm(role="group" aria-label="Share pages")
                    button.btn.btn-outline-light(type="button" data-share-previous) Previous
                    button.btn.btn-outline-light(type="button" data-share-next) Next
            .pool-form-status.small(role="status" aria-live="polite" aria-atomic="true" data-share-feedback)
        +poolEditModal(pool, 'share-breakdown', 'Share breakdown')
            h6(data-share-details-payer)
            div(data-share-details-content)
            .d-flex.justify-content-end.mt-3
                button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close

//- Takeover summary with consistent layout and manage button
mixin takeoverOverview(pool, participants, mode, options)
    - const showHeading = !(options && options.showHeading === false);
    if showHeading
        h6.mb-2 Takeovers
        p.text-secondary.small.mb-2 Assign which participant covers another's share. Covered participants cannot take over other shares.
    +poolCoverageOverview(pool, participants, mode)
    button.btn.btn-outline-light.btn-sm.manage-takeovers.align-self-end.mt-2(type="button" data-id=pool.id data-mode=mode disabled=mode === 'participant' && pool.status !== 'OPEN')
        i.bi.bi-person-check.me-1(aria-hidden="true")
        | Manage takeovers

//- Participant takeover chooser reused on the registration page
mixin participantTakeoverList(pools, participants)
    - const participantList = participants || [];
    if pools && pools.length
        h6.mt-4 Takeovers
        p.text-secondary.small.mb-2 Choose whose share you will cover in each pool. Covered participants cannot take over other shares.
        each pool in pools
            - const assignments = pool.assignments || []
            - const assignedIds = pool.assignAll ? participantList.map(p => p.id) : (pool.assignments || []).map(a => a.registration?.id)
            - const takeoverData = (pool.takeovers || []).map(t => ({payerRegistrationId: t.payerRegistrationId, beneficiaryRegistrationId: t.beneficiaryRegistrationId}))
            .border.border-secondary-subtle.rounded-3.p-3.mb-2(data-pool=pool.id data-pool-name=pool.name data-pool-status=pool.status data-assigned=JSON.stringify(assignedIds) data-takeovers=JSON.stringify(takeoverData))
                .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2
                    .d-flex.flex-column
                        strong #{pool.name}
                        small.text-secondary Covers #{pool.assignAll ? 'all participants' : assignments.length}
                    +takeoverOverview(pool, participantList, 'participant', {showHeading: false})

//- Render a single proof link, keeping the markup consistent across admin/participant views
mixin invoiceProofLink(inv, eventId, poolId)
    if inv.proofPath
        a.text-info(href=`/api/event/${eventId}/invoice-pools/${poolId}/invoices/${inv.id}/proof` target="_blank" rel="noopener noreferrer" title=inv.proofOriginalName || 'Invoice proof')
            i.bi.bi-file-earmark-text.me-1(aria-hidden="true")
            | View proof
    else
        span.text-secondary #{inv.registrationId == null && !inv.proofOriginalName ? 'No proof attached' : 'Proof expired'}

//- Human-readable status badge shared by administration and participant history.
mixin invoiceStatusBadge(status)
    if status === 'NEW'
        span.badge.bg-warning.text-dark Awaiting review
    else if status === 'APPROVED'
        span.badge.bg-success Accepted
    else if status === 'REJECTED'
        span.badge.bg-danger Rejected
    else if status === 'RETRACTED'
        span.badge.bg-secondary Retracted
    else
        span.badge.bg-secondary Closed

//- Search, status filter, and paging controls shared by ledgers with hundreds of rows.
mixin invoiceLedgerToolbar(title, invoices)
    - const newCount = invoices.filter(invoice => invoice.status === 'NEW').length
    - const acceptedCount = invoices.filter(invoice => invoice.status === 'APPROVED').length
    - const rejectedCount = invoices.filter(invoice => invoice.status === 'REJECTED').length
    - const closedCount = invoices.filter(invoice => invoice.status === 'CLOSED').length
    - const retractedCount = invoices.filter(invoice => invoice.status === 'RETRACTED').length
    .invoice-ledger-toolbar.d-flex.flex-wrap.align-items-center.justify-content-between.gap-2.mb-2
        .d-flex.flex-wrap.align-items-center.gap-2
            h6.mb-0= title
            span.badge.bg-secondary #{invoices.length} total
            if newCount
                span.badge.bg-warning.text-dark #{newCount} new
            if acceptedCount
                span.badge.bg-success #{acceptedCount} accepted
            if rejectedCount
                span.badge.bg-danger #{rejectedCount} rejected
            if closedCount
                span.badge.bg-secondary #{closedCount} closed
            if retractedCount
                span.badge.bg-secondary #{retractedCount} retracted
        .invoice-ledger-controls.d-flex.flex-wrap.gap-2
            input.form-control.form-control-sm.text-bg-dark.invoice-ledger-search(type="search" data-invoice-search-input placeholder="Search invoices" aria-label="Search invoices")
            select.form-select.form-select-sm.text-bg-dark(data-invoice-status-filter aria-label="Filter invoice status")
                option(value="") All statuses
                option(value="NEW") Awaiting review
                option(value="APPROVED") Accepted
                option(value="REJECTED") Rejected
                option(value="CLOSED") Closed
                option(value="RETRACTED") Retracted
            select.form-select.form-select-sm.text-bg-dark(data-invoice-page-size aria-label="Invoices per page")
                option(value="25") 25 per page
                option(value="50") 50 per page
                option(value="100") 100 per page

mixin invoiceLedgerFooter
    .invoice-ledger-footer.d-flex.flex-wrap.align-items-center.justify-content-between.gap-2.mt-2
        small.text-secondary(data-invoice-page-summary)
        .btn-group.btn-group-sm(role="group" aria-label="Invoice pages")
            button.btn.btn-outline-light(type="button" data-invoice-page-previous)
                i.bi.bi-chevron-left.me-1(aria-hidden="true")
                | Previous
            button.btn.btn-outline-light(type="button" data-invoice-page-next)
                | Next
                i.bi.bi-chevron-right.ms-1(aria-hidden="true")

//- Organizer ledger keeps original data, corrections, rejection history, and actions together.
mixin adminInvoiceOverview(pool, eventId, participants)
    - const invoices = [...(pool.invoices || [])].sort((left, right) => new Date((right.track && right.track.createdAt) || 0).getTime() - new Date((left.track && left.track.createdAt) || 0).getTime())
    if invoices.length
        .invoice-ledger.border.border-secondary-subtle.rounded-3.bg-black.p-3.mt-3(data-invoice-ledger)
            +invoiceLedgerToolbar('Invoice administration', invoices)
            .table-responsive.invoice-ledger-table
                table.table.table-dark.table-hover.align-middle.mb-0
                    thead
                        tr
                            th Invoice
                            th Participant / source
                            th Submitted details
                            th Organizer review
                            th Status
                            th Proof
                            th Actions
                    tbody
                        each inv in invoices
                            - const participant = (participants || []).find(row => row.id === inv.registrationId)
                            - const isPoolExpense = inv.registrationId == null
                            - const participantName = isPoolExpense ? (inv.recordedByName || inv.recordedByProfile?.name || 'Organizer') : (participant && participant.name) || `Participant #${inv.registrationId}`
                            - const participantEmail = (participant && participant.email) || ''
                            - const searchText = `${inv.id} ${isPoolExpense ? 'pool expense' : ''} ${participantName} ${participantEmail} ${inv.amount} ${inv.description || ''} ${inv.correctedAmount || ''} ${inv.correctedDescription || ''} ${inv.rejectionReason || ''}`.toLowerCase()
                            - const createdAt = inv.track && inv.track.createdAt
                            tr(data-invoice-row data-invoice-status=inv.status data-invoice-search=searchText)
                                td(data-label="Invoice")
                                    strong ##{inv.id}
                                    small.text-secondary.d-block= `${isPoolExpense ? 'Recorded' : 'Submitted'} ${fmtInvoiceDate(createdAt)}`
                                td(data-label="Participant / source")
                                    strong.d-block= isPoolExpense ? 'Pool expense' : participantName
                                    if isPoolExpense
                                        small.text-secondary Recorded by #{participantName}
                                    else if participantEmail && participantEmail !== '—'
                                        small.text-secondary= participantEmail
                                td.invoice-cell-wide(data-label="Submitted details")
                                    strong.d-block #{fmtMoney(inv.amount)}
                                    small.text-secondary.invoice-description= inv.description || 'No description'
                                td.invoice-cell-wide(data-label="Organizer review")
                                    if inv.status === 'NEW'
                                        .invoice-review-fields
                                            label.form-label.small.mb-1 Corrected amount
                                            input.form-control.form-control-sm.text-bg-dark.invoice-corrected-amount(type="number" min="0.01" step="0.01" placeholder=`Keep ${fmtMoney(inv.amount)}` aria-label=`Corrected amount for invoice ${inv.id}`)
                                            label.form-label.small.mt-2.mb-1 Corrected description
                                            textarea.form-control.form-control-sm.text-bg-dark.invoice-corrected-description(rows="2" maxlength="4000" placeholder="Leave blank to keep submitted description" aria-label=`Corrected description for invoice ${inv.id}`)
                                            label.form-label.small.mt-2.mb-1 Rejection reason
                                            textarea.form-control.form-control-sm.text-bg-dark.invoice-rejection-reason(rows="2" maxlength="4000" placeholder="Required when rejecting" aria-label=`Rejection reason for invoice ${inv.id}`)
                                    else if inv.correctedAmount || inv.correctedDescription
                                        if inv.correctedAmount
                                            strong.d-block #{fmtMoney(inv.correctedAmount)}
                                            small.text-secondary.d-block Original: #{fmtMoney(inv.amount)}
                                        if inv.correctedDescription
                                            small.d-block.mt-1= inv.correctedDescription
                                    else
                                        span.text-secondary.small No corrections
                                td(data-label="Status")
                                    +invoiceStatusBadge(inv.status)
                                    if inv.rejectionReason
                                        small.text-danger-emphasis.d-block.mt-2= inv.rejectionReason
                                td(data-label="Proof")
                                    +invoiceProofLink(inv, eventId, pool.id)
                                td.invoice-cell-actions(data-label="Actions")
                                    .d-flex.flex-wrap.gap-1
                                        if inv.status === 'NEW'
                                            button.btn.btn-success.btn-sm.invoice-approve(type="button" data-pool=pool.id data-id=inv.id)
                                                i.bi.bi-check2.me-1(aria-hidden="true")
                                                | Accept
                                            button.btn.btn-outline-danger.btn-sm.invoice-decline(type="button" data-pool=pool.id data-id=inv.id)
                                                i.bi.bi-x-lg.me-1(aria-hidden="true")
                                                | Reject
                                        else if inv.status === 'APPROVED' || inv.status === 'CLOSED'
                                            button.btn.btn-outline-light.btn-sm.invoice-edit-open(type="button" data-pool=pool.id data-id=inv.id data-revision=pool.calculationRevision data-amount=(inv.correctedAmount != null ? inv.correctedAmount : inv.amount) data-description=(inv.correctedDescription != null ? inv.correctedDescription : (inv.description || '')) data-original-description=inv.description data-pool-status=pool.status)
                                                i.bi.bi-pencil.me-1(aria-hidden="true")
                                                | Correct
                                            button.btn.btn-outline-danger.btn-sm.invoice-reject-open(type="button" data-pool=pool.id data-id=inv.id data-revision=pool.calculationRevision data-amount=(inv.correctedAmount != null ? inv.correctedAmount : inv.amount) data-description=(inv.correctedDescription != null ? inv.correctedDescription : (inv.description || '')) data-pool-status=pool.status)
                                                i.bi.bi-x-circle.me-1(aria-hidden="true")
                                                | Reject from pool
                                            if inv.status === 'APPROVED'
                                                button.btn.btn-outline-light.btn-sm.invoice-close(type="button" data-pool=pool.id data-id=inv.id)
                                                    i.bi.bi-check2-circle.me-1(aria-hidden="true")
                                                    | Close
                                        else
                                            span.text-secondary.small No actions
            .invoice-ledger-empty.text-secondary.small.py-3.text-center(hidden data-invoice-empty) No invoices match these filters.
            +invoiceLedgerFooter
    else
        p.text-secondary.mb-0.mt-3 No invoices yet.

//- Participant history exposes the full audit trail, including accepted corrections and rejection reasons.
mixin participantInvoiceOverview(invoices, pools, eventId)
    - const orderedInvoices = [...(invoices || [])].sort((left, right) => new Date((right.track && right.track.createdAt) || 0).getTime() - new Date((left.track && left.track.createdAt) || 0).getTime())
    if orderedInvoices.length
        .invoice-ledger.border.border-secondary-subtle.rounded-3.bg-black.p-3.mt-3(data-invoice-ledger)
            +invoiceLedgerToolbar('Your invoice history', orderedInvoices)
            .table-responsive.invoice-ledger-table
                table.table.table-dark.table-hover.align-middle.mb-0
                    thead
                        tr
                            th Invoice
                            th Pool
                            th Amount
                            th Description
                            th Status
                            th Proof
                            th Actions
                    tbody
                        each inv in orderedInvoices
                            - const historyPool = pools.find(pool => pool.id === inv.poolId) || inv.pool
                            - const poolName = historyPool?.name || 'Archived pool'
                            - const searchText = `${inv.id} ${poolName} ${inv.amount} ${inv.description || ''} ${inv.correctedAmount || ''} ${inv.correctedDescription || ''} ${inv.rejectionReason || ''}`.toLowerCase()
                            - const createdAt = inv.track && inv.track.createdAt
                            tr(data-invoice-row data-invoice-status=inv.status data-invoice-search=searchText)
                                td(data-label="Invoice")
                                    strong ##{inv.id}
                                    small.text-secondary.d-block= fmtInvoiceDate(createdAt)
                                td(data-label="Pool")= poolName
                                td(data-label="Amount")
                                    strong.d-block #{fmtMoney(inv.correctedAmount || inv.amount)}
                                    if inv.correctedAmount
                                        small.text-secondary Original: #{fmtMoney(inv.amount)}
                                td.invoice-cell-wide(data-label="Description")
                                    span.d-block= inv.correctedDescription || inv.description || 'No description'
                                    if inv.correctedDescription && inv.description
                                        small.text-secondary.d-block Original: #{inv.description}
                                td(data-label="Status")
                                    +invoiceStatusBadge(inv.status)
                                    if inv.rejectionReason
                                        small.text-danger-emphasis.d-block.mt-2
                                            strong Reason:
                                            |  #{inv.rejectionReason}
                                td(data-label="Proof")
                                    +invoiceProofLink(inv, eventId, inv.poolId)
                                td.invoice-cell-actions(data-label="Actions")
                                    if inv.status === 'NEW'
                                        button.btn.btn-outline-danger.btn-sm.invoice-retract-open(type="button" data-pool=inv.poolId data-id=inv.id data-revision=(historyPool && historyPool.calculationRevision) data-amount=inv.amount data-description=inv.description)
                                            i.bi.bi-arrow-counterclockwise.me-1(aria-hidden="true")
                                            | Retract
                                    else if inv.status === 'APPROVED'
                                        button.btn.btn-sm.btn-outline-success.invoice-close-self(type="button" data-pool=inv.poolId data-id=inv.id)
                                            i.bi.bi-check2-circle.me-1(aria-hidden="true")
                                            | Close
                                    else
                                        span.text-secondary.small No actions
            .invoice-ledger-empty.text-secondary.small.py-3.text-center(hidden data-invoice-empty) No invoices match these filters.
            +invoiceLedgerFooter
    else
        p.text-secondary.small.mb-0 You have not submitted any invoices yet.

//- Invoice overview that adapts to admin and participant needs
mixin invoiceOverview(mode, options)
    - const pools = options?.pools || [];
    - const eventId = options?.eventId;
    - const invoices = options?.invoices;
    if mode === 'admin' && options.pool
        +adminInvoiceOverview(options.pool, eventId, options.participants || [])
    else if mode === 'participant'
        +participantInvoiceOverview(invoices || [], pools, eventId)

//- Collapsible invoice submission area for both admins (on behalf) and participants
mixin invoiceSubmission(eventId, pools, mode, invoices, allPools = [])
    - const hasPools = pools && pools.length;
    - const overviewPools = [...new Map([...(allPools || []), ...(pools || [])].map(pool => [pool.id, pool])).values()];
    .accordion.accordion-dark.mb-3#invoiceSubmission
        .accordion-item.bg-dark.text-white.border-secondary-subtle
            h2.accordion-header
                button.accordion-button.collapsed.text-white(type="button" data-bs-toggle="collapse" data-bs-target="#invoicePoolCollapse" aria-expanded="false" aria-controls="invoicePoolCollapse")
                    i.bi.bi-receipt.me-2(aria-hidden="true")
                    | Submit an invoice & history
            #invoicePoolCollapse.accordion-collapse.collapse
                .accordion-body
                    if hasPools
                        form#invoiceSubmitForm(data-api=`/api/event/${eventId}/invoice-pools/${pools[0].id}/submit` enctype="multipart/form-data")
                            fieldset.border-0.p-0.m-0(data-invoice-fields)
                                legend.visually-hidden Invoice details and proof
                                .row.g-2
                                    .col-md-4
                                        label.form-label(for="invoicePool") Choose pool
                                        select#invoicePool.form-select.text-bg-dark(name="poolId" required)
                                            each pool in pools
                                                option(value=pool.id)= pool.name
                                    .col-md-4
                                        label.form-label(for="invoiceAmount") Amount
                                        input#invoiceAmount.form-control.text-bg-dark(type="number" name="amount" step="0.01" min="0.01" required)
                                    .col-md-4
                                        label.form-label(for="invoiceDescription") Description
                                        input#invoiceDescription.form-control.text-bg-dark(type="text" name="description")
                                    .col-12
                                        label.form-label(for="invoiceProof") Proof (image or PDF)
                                        input#invoiceProof.form-control.text-bg-dark(type="file" name="proof" accept="image/jpeg,image/png,image/gif,application/pdf" required)
                            .mt-3(data-invoice-feedback hidden)
                                #invoiceSubmitStatus.alert.alert-info.mb-2(data-invoice-status role="status" aria-live="polite" aria-atomic="true" tabindex="-1")
                                .progress.mb-2(data-invoice-progress hidden role="progressbar" aria-label="Invoice upload progress" aria-valuemin="0" aria-valuemax="100")
                                    .progress-bar.progress-bar-striped.progress-bar-animated(data-invoice-progress-bar style="width: 100%")
                                button.btn.btn-outline-light.btn-sm(type="button" data-invoice-history hidden) View invoice history
                            .d-flex.justify-content-end.mt-2
                                button.btn.btn-primary(type="submit" aria-describedby="invoiceSubmitStatus")
                                    i.bi.bi-cloud-upload.me-1(aria-hidden="true")
                                    | Submit invoice
                    else
                        .alert.alert-info(role="status")
                            i.bi.bi-info-circle.me-2(aria-hidden="true")
                            | No open pools for submissions right now.
                    #invoiceHistory
                        +invoiceOverview('participant', {invoices: invoices || [], pools: overviewPools, eventId: eventId})
    +invoiceRetractionDialog

//- Participant-friendly snapshot of what they owe in closed pools
mixin participantShareSummary(registrationId, pools)
    - const rows = [];
    each pool in pools || []
        if pool.shares && pool.shares.length
            each share in pool.shares
                if share.registrationId === registrationId
                    - rows.push({pool, share});
    if rows.length
        h6.mt-3 Your pool shares
        p.text-secondary.small Previously settled includes payments received (positive) or refunds already paid out (negative) before this calculation. The Paid status shows whether the remaining amount has also been settled.
        .table-responsive
            table.table.table-dark.table-sm
                thead
                    tr
                        th Pool
                        th Base
                        th Adjustments
                        th Invoice credit
                        th Previously settled
                        th Remaining due / refund
                        th Notes
                        th Status
                tbody
                    each row in rows
                        - const notes = (row.share.note || '').split(' • ').filter(Boolean);
                        tr
                            td
                                span.d-block #{row.pool.name}
                                if row.pool.needsRecalculation
                                    span.badge.bg-warning.text-dark Recalculation required
                                    small.d-block.text-warning These amounts are from the previous calculation. Recorded payments will be credited when the organizer recalculates.
                            td #{fmtMoney(row.share.baseShareAmount)}
                            td #{fmtMoney(row.share.extraAmount)}
                            td #{fmtMoney(row.share.invoiceCreditAmount)}
                            td #{fmtMoney(row.share.paymentCreditAmount)}
                            td
                                strong #{fmtMoney(row.share.shareAmount)}
                                if Number(row.share.shareAmount) < 0 && !row.share.isPaid
                                    small.d-block.text-info Refund due
                            td
                                if notes.length
                                    ul.list-unstyled.mb-0
                                        each note in notes
                                            li.text-secondary.small= note
                                else
                                    span.text-secondary.small No notes
                            td
                                if row.share.isPaid || Number(row.share.shareAmount) === 0
                                    span.badge.bg-success.text-dark Settled
                                else if Number(row.share.shareAmount) < 0
                                    span.badge.bg-info.text-dark Refund
                                else
                                    span.badge.bg-warning.text-dark Due

//- Compact pool summary keeps the next action and calculation state visible.
mixin poolHeaderSummary(pool)
    .d-flex.align-items-center.w-100.justify-content-between.flex-wrap.gap-3
        .d-flex.flex-column.flex-grow-1
            .d-flex.align-items-center.flex-wrap.gap-2
                span.fw-semibold #{pool.name}
                if pool.isDefault
                    span.badge.bg-primary.text-dark Default
                if pool.needsRecalculation
                    span.badge.bg-warning.text-dark Recalculation required
            small.text-secondary.mb-0 #{pool.description || 'Shared event costs'}
        .d-flex.align-items-center.gap-3.me-2
            span.badge.bg-info.text-dark #{pool.status === 'OPEN' ? 'Open for invoices' : 'Closed'}
            span.fw-bold #{fmtMoney(pool.totalAmount)}

mixin poolStats(pool)
    .pool-totals.border.border-secondary-subtle.rounded-3.p-3.bg-black
        .row.g-3
            .col-6.col-lg-3
                small.text-secondary.d-block Full total
                strong.fs-4 #{fmtMoney(pool.totalAmount)}
            .col-6.col-lg-3
                small.text-secondary.d-block Distributable total
                strong.fs-4 #{fmtMoney(pool.payableAmount)}
            .col-6.col-lg-3
                small.text-secondary.d-block Outstanding payments
                strong.fs-4(data-pool-outstanding) #{fmtMoney(pool.outstandingAmount)}
            .col-6.col-lg-3
                small.text-secondary.d-block Credits owed
                strong.fs-4(data-pool-refunds) #{fmtMoney(pool.creditAmount)}
        details.mt-3.small
            summary.text-info Calculation breakdown
            dl.row.g-2.mb-0.mt-1
                dt.col-7.col-sm-8 Total invoices
                dd.col-5.col-sm-4.text-end #{fmtMoney(pool.invoiceAmount)}
                dt.col-7.col-sm-8 Open invoices
                dd.col-5.col-sm-4.text-end #{fmtMoney(pool.openAmount)}
                dt.col-7.col-sm-8 Additional charges / credits
                dd.col-5.col-sm-4.text-end #{fmtMoney(pool.additionalAmount)}
                dt.col-7.col-sm-8 Redistributed surcharges / rebates
                dd.col-5.col-sm-4.text-end #{fmtMoney(pool.surchargeOffsetAmount)}
                dt.col-7.col-sm-8 Distribution mode
                dd.col-5.col-sm-4.text-end #{pool.distributionMethod === 'EQUAL' ? 'Participants' : pool.distributionMethod === 'NIGHTS' ? 'Nights stayed' : 'Days attended'}
                dt.col-7.col-sm-8 Deduct submitter invoices
                dd.col-5.col-sm-4.text-end #{pool.subtractPersonalInvoices ? 'Enabled' : 'Disabled'}
                dt.col-7.col-sm-8 Assigned participants
                dd.col-5.col-sm-4.text-end #{pool.assignAll ? 'All participants' : (pool.assignments || []).length}
            p.text-secondary.mb-0 Factors multiply each participant's distribution weight before the shared total is divided. Surcharges and rebates are applied afterwards.
        if pool.needsRecalculation
            p.text-warning.small.mt-2.mb-0 Pool totals reflect saved changes. Outstanding payments and credits still reflect the previous calculation.

mixin poolSaveNotice(pool)
    if pool.status === 'CLOSED'
        p.text-warning.small.mb-3 Save your changes here, then preview Recalculate pool. Existing shares stay visible; recorded payments and refunds are carried forward as settlement credits.

mixin poolFormFooter(label)
    .pool-form-status.mt-3(role="status" aria-live="polite" tabindex="-1")
    .d-flex.justify-content-end.flex-wrap.gap-2.mt-3
        button.btn.btn-outline-secondary(type="reset") Discard edits
        button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close
        button.btn.btn-primary(type="submit")
            i.bi.bi-save.me-1(aria-hidden="true")
            | #{label}

mixin poolAssignmentsForm(ev, pool, participants)
    form.pool-assignment(data-api=`/api/event/${ev.id}/invoice-pools/${pool.id}/assignments` data-pool=pool.id data-pool-status=pool.status)
        +poolSaveNotice(pool)
        .form-check
            input.form-check-input.pool-toggle(type="checkbox" name="assignAll" id=`assign-${pool.id}` checked=!!pool.assignAll)
            label.form-check-label(for=`assign-${pool.id}`) Assign to all participants
        .form-check
            input.form-check-input.pool-toggle(type="checkbox" name="isDefault" id=`default-${pool.id}` checked=!!pool.isDefault)
            label.form-check-label(for=`default-${pool.id}`) Default for new participants
        .form-check
            input.form-check-input(type="checkbox" name="subtractPersonalInvoices" id=`subtract-invoices-${pool.id}` checked=!!pool.subtractPersonalInvoices)
            label.form-check-label(for=`subtract-invoices-${pool.id}`) Deduct submitter invoices from their share
        p.text-secondary.small.mt-2 Default pools automatically include future participants. Each new participant starts with a share factor of 1.
        .border.border-secondary-subtle.rounded-3.p-3.mb-3
            strong Share factors
            p.small.mb-1 1 is the default. 1.5 gives 50% more weight; 0.5 gives half the weight. Final shares are normalized so the shared total stays the same.
            p.text-secondary.small.mb-0 Factors apply to the participant, days attended, or nights stayed. Exempt removes the automatic base share; surcharges, rebates, invoice credits, and takeovers still apply.
        label.form-label(for=`assign-search-${pool.id}`) Search participants
        input.form-control.text-bg-dark.assignment-search.mb-2(id=`assign-search-${pool.id}` type="search" placeholder="Filter by name or email")
        .assignments-list.pool-participant-list.border.border-secondary-subtle.rounded-3.bg-black.text-white(id=`assign-list-${pool.id}`)
            if participants && participants.length
                each p in participants
                    - const assignment = (pool.assignments || []).find(a => (a.registrationId || a.registration?.id) === p.id)
                    - const selected = pool.assignAll || !!assignment
                    - const participantFactor = assignment && assignment.factor != null ? assignment.factor : '1'
                    .pool-participant-row.p-3.border-bottom.border-secondary-subtle(data-search-text=`${String(p.name || '').toLowerCase()} ${String(p.email || '').toLowerCase()}` data-registration=p.id)
                        .form-check.mb-0
                            input.form-check-input(type="checkbox" name="registrations" value=p.id id=`pool-${pool.id}-reg-${p.id}` checked=selected disabled=!!pool.assignAll)
                            label.form-check-label(for=`pool-${pool.id}-reg-${p.id}`)
                                strong.d-block= p.name
                                small.text-secondary= p.email
                        .pool-factor-field
                            label.form-label.small.mb-1(for=`pool-${pool.id}-factor-${p.id}`) Share factor
                            input.form-control.form-control-sm.text-bg-dark(type="number" name=`factor-${p.id}` data-participant-factor=p.id id=`pool-${pool.id}-factor-${p.id}` min="0" max="1000" step="0.0001" value=participantFactor required disabled=!selected aria-describedby=`factor-help-${pool.id}`)
                        .form-check.form-switch.mb-0
                            input.form-check-input(type="checkbox" name="exemptions" value=p.id id=`pool-${pool.id}-exempt-${p.id}` checked=!!(assignment && assignment.isExempt) disabled=!selected)
                            label.form-check-label(for=`pool-${pool.id}-exempt-${p.id}`) Exempt
            else
                p.text-secondary.small.p-3.mb-0 No participants yet.
        p.text-secondary.small.mt-2.mb-0(id=`factor-help-${pool.id}`) Factors can be 0 to 1000, with up to four decimal places. A factor of 0 gives no automatic base share.
        +poolFormFooter('Save participants & factors')

mixin poolSurchargeList(pool, participants)
    if pool.surcharges && pool.surcharges.length
        ul.list-group.list-group-flush.bg-dark.mb-3
            each surcharge in pool.surcharges
                - const participant = (participants || []).find(p => p.id === surcharge.registrationId)
                - const participantName = participant && participant.name || `Participant #${surcharge.registrationId}`
                - const rebate = Number(surcharge.amount) < 0
                li.list-group-item.bg-dark.text-white.d-flex.justify-content-between.align-items-start.gap-2.px-0
                    .flex-grow-1
                        strong.me-2 #{participantName}
                        span.badge(class=rebate ? 'bg-success' : 'bg-secondary') #{rebate ? 'Rebate' : 'Surcharge'} #{fmtMoney(surcharge.amount)}
                        small.d-block.text-secondary.mt-1 #{surcharge.subtractFromPool ? 'Redistributed within pool' : 'Additional charge / credit'}
                        p.mb-0.small #{surcharge.note}
                    button.btn.btn-outline-danger.btn-sm.surcharge-remove(type="button" data-pool=pool.id data-id=surcharge.id aria-label=`Remove ${rebate ? 'rebate' : 'surcharge'} for ${participantName}`) Remove
    else
        p.text-secondary.small No surcharges or rebates added yet.

mixin poolSurchargeForm(ev, pool, participants)
    form.surcharge-form(data-api=`/api/event/${ev.id}/invoice-pools/${pool.id}/surcharges` data-pool=pool.id data-pool-status=pool.status)
        .row.g-3
            .col-sm-6
                label.form-label(for=`surcharge-target-${pool.id}`) Participant
                select.form-select.text-bg-dark(id=`surcharge-target-${pool.id}` name="registrationId" required)
                    option(value="") Choose participant
                    each p in participants
                        - const assigned = pool.assignAll || (pool.assignments || []).some(a => (a.registrationId || a.registration?.id) === p.id)
                        if assigned
                            option(value=p.id)= p.name
            .col-sm-6
                label.form-label(for=`surcharge-amount-${pool.id}`) Amount (negative for a rebate)
                input.form-control.text-bg-dark(id=`surcharge-amount-${pool.id}` type="number" name="amount" step="0.01" required placeholder="e.g. 10.00 or -10.00" aria-describedby=`surcharge-help-${pool.id}`)
            .col-12
                label.form-label(for=`surcharge-note-${pool.id}`) Note
                input.form-control.text-bg-dark(id=`surcharge-note-${pool.id}` type="text" name="note" required maxlength="4000" placeholder="Explain the surcharge or rebate")
            .col-12
                .form-check.form-switch
                    input.form-check-input(id=`surcharge-subtract-${pool.id}` type="checkbox" name="subtractFromPool" checked)
                    label.form-check-label(for=`surcharge-subtract-${pool.id}`) Redistribute within pool
                p.text-secondary.small.mt-2.mb-0(id=`surcharge-help-${pool.id}`) Selected: a surcharge reduces the shared total; a rebate increases it, keeping the full pool total unchanged. Cleared: an additional charge or credit changes the full total; other shares stay unchanged. Amount cannot be zero.
        +poolFormFooter('Add surcharge or rebate')

mixin poolAdjustmentSection(ev, pool, participants)
    +poolSaveNotice(pool)
    p.small Give a participant a fixed surcharge (positive amount) or rebate (negative amount). These are added after their automatic base share, and are not multiplied by their factor.
    +poolSurchargeList(pool, participants)
    h6.mt-3 Add an adjustment
    +poolSurchargeForm(ev, pool, participants)

mixin poolShareSection(pool, participants, eventId)
    if pool.shares && pool.shares.length
        h6.mb-2 Shares & settlement
        if pool.needsRecalculation
            p.text-warning.small Recalculation required. These are the previous calculated amounts. You can still record their settlement; recalculation credits those payments and refunds against the updated shares.
        p.text-secondary.small Previously settled records payments received (positive) or refunds already paid out (negative). Calculated balance is the share after this credit: positive means Due, negative means Refund. The Paid switch marks that balance Settled after payment or payout.
        +invoiceShareTable(pool, participants, true, eventId)
    else if pool.status === 'CLOSED'
        p.text-secondary.small No participant shares were generated.

mixin poolEditModal(pool, suffix, title)
    .modal.fade.pool-edit-modal(id=`pool-${pool.id}-${suffix}` tabindex="-1" aria-labelledby=`pool-${pool.id}-${suffix}-title` aria-hidden="true" data-pool=pool.id)
        .modal-dialog.modal-lg.modal-dialog-scrollable.modal-fullscreen-sm-down
            .modal-content.bg-dark.text-white
                .modal-header
                    h5.modal-title(id=`pool-${pool.id}-${suffix}-title`) #{title} · #{pool.name}
                    button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Close")
                .modal-body
                    block

//- Group coverage by payer so the relationship is clear before editing.
mixin poolCoverageOverview(pool, participants, mode)
    -
        const participantNames = new Map((participants || []).map(p => [p.id, p.name]));
        const coverageByPayer = new Map();
        for (const takeover of pool.takeovers || []) {
            const id = takeover.payerRegistrationId;
            if (!coverageByPayer.has(id)) coverageByPayer.set(id, {id, name: participantNames.get(id) || `Participant #${id}`, beneficiaries: []});
            coverageByPayer.get(id).beneficiaries.push({id: takeover.beneficiaryRegistrationId, name: participantNames.get(takeover.beneficiaryRegistrationId) || `Participant #${takeover.beneficiaryRegistrationId}`});
        }
        const coverageGroups = [...coverageByPayer.values()].sort((a, b) => a.name.localeCompare(b.name));
        coverageGroups.forEach(group => group.beneficiaries.sort((a, b) => a.name.localeCompare(b.name)));
        const currentRegistrationId = mode === 'participant' && data && data.registration ? data.registration.id : null;
    - const coverageId = `pool-${pool.id}-coverage-${mode}`
    .pool-takeover-summary.w-100(data-takeover-overview)
        if coverageGroups.length
            .d-flex.align-items-center.flex-wrap.justify-content-between.gap-2.mb-2
                small.text-secondary #{coverageGroups.length} covering payer#{coverageGroups.length === 1 ? '' : 's'} · #{(pool.takeovers || []).length} covered participants
            .takeover-overview-controls.d-flex.flex-wrap.gap-2.mb-2
                input.form-control.form-control-sm.text-bg-dark(id=`${coverageId}-search` type="search" data-takeover-overview-search placeholder="Find a payer or covered participant" aria-label="Search takeovers")
                select.form-select.form-select-sm.text-bg-dark(data-takeover-page-size aria-label="Takeover payers per page")
                    option(value="10") 10 per page
                    option(value="25") 25 per page
                    option(value="50") 50 per page
            .table-responsive.pool-takeover-table
                table.table.table-dark.table-striped.table-bordered.align-middle.mb-0
                    caption.visually-hidden Payers and the participants whose shares they cover
                    thead
                        tr
                            th(scope="col") Payer
                            th(scope="col") Covered participants
                            if mode === 'admin'
                                th(scope="col") Actions
                    tbody
                        each group in coverageGroups
                            - const beneficiaryListId = `${coverageId}-payer-${group.id}`
                            tr(data-takeover-overview-row data-payer-name=group.name data-search-text=`${group.name} ${group.beneficiaries.map(p => p.name).join(' ')}`.toLowerCase())
                                th.fw-normal(scope="row" data-label="Payer")
                                    strong= group.name
                                    if currentRegistrationId === group.id
                                        span.badge.bg-info.text-dark.ms-2 You
                                    small.text-secondary.d-block.mt-1 Covers #{group.beneficiaries.length} participant#{group.beneficiaries.length === 1 ? '' : 's'}
                                td(data-label="Covered participants")
                                    .takeover-beneficiary-chips.d-flex.flex-wrap.align-content-start.gap-1(id=beneficiaryListId data-takeover-beneficiaries tabindex="0" role="group" aria-label=`Participants covered by ${group.name}`)
                                        each beneficiary in group.beneficiaries
                                            span.badge.coverage-name-chip(data-takeover-beneficiary data-beneficiary-name=beneficiary.name class=currentRegistrationId === beneficiary.id ? 'bg-info text-dark' : 'bg-secondary')
                                                | #{beneficiary.name}
                                                if currentRegistrationId === beneficiary.id
                                                    |  (You)
                                    .d-flex.flex-wrap.align-items-center.gap-2.mt-2(data-takeover-beneficiary-controls hidden)
                                        small.text-secondary(data-takeover-beneficiary-summary role="status" aria-live="polite")
                                        button.btn.btn-outline-light.btn-sm(type="button" data-takeover-expand aria-expanded="false" aria-controls=beneficiaryListId hidden) Show all #{group.beneficiaries.length}
                                if mode === 'admin'
                                    td(data-label="Actions")
                                        button.btn.btn-outline-light.btn-sm.manage-takeovers(type="button" data-id=pool.id data-payer=group.id data-mode="admin" aria-label=`Edit takeovers for ${group.name}`)
                                            i.bi.bi-pencil.me-1(aria-hidden="true")
                                            | Edit
            p.text-secondary.small.py-3.mb-0(hidden data-takeover-empty) No takeovers match this search.
            .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mt-2
                small.text-secondary(data-takeover-page-summary role="status" aria-live="polite")
                .btn-group.btn-group-sm(role="group" aria-label="Takeover pages")
                    button.btn.btn-outline-light(type="button" data-takeover-previous) Previous
                    button.btn.btn-outline-light(type="button" data-takeover-next) Next
        else
            p.text-secondary.small.mb-0 Each participant covers their own share. Use Manage takeovers to choose a payer who covers someone else.
        if pool.needsRecalculation
            p.text-warning.small.mt-2.mb-0 These saved takeovers apply after recalculation. Previous share notes retain the previous coverage.

mixin poolTakeoverSummary(pool, participants)
    .border.border-secondary-subtle.rounded-3.p-3.mt-3
        h6.mb-2 Takeovers
        +poolCoverageOverview(pool, participants, 'admin')

mixin poolManagementSection(ev, pool, participants)
    - const assignedIds = pool.assignAll ? participants.map(p => p.id) : (pool.assignments || []).map(a => a.registrationId || a.registration?.id)
    - const takeoverData = (pool.takeovers || []).map(t => ({payerRegistrationId: t.payerRegistrationId, beneficiaryRegistrationId: t.beneficiaryRegistrationId}))
    - const newCount = (pool.invoices || []).filter(inv => inv.status === 'NEW').length
    .accordion-item.bg-dark.text-white.border-secondary-subtle.invoice-pool(data-pool=pool.id data-pool-name=pool.name data-pool-status=pool.status data-assigned=JSON.stringify(assignedIds) data-takeovers=JSON.stringify(takeoverData))
        h2.accordion-header
            button.accordion-button.collapsed.text-white(type="button" data-bs-toggle="collapse" data-bs-target=`#pool-${pool.id}-body` aria-expanded="false" aria-controls=`pool-${pool.id}-body`)
                +poolHeaderSummary(pool)
        .accordion-collapse.collapse(id=`pool-${pool.id}-body`)
            .accordion-body
                if pool.needsRecalculation
                    .status-notice.alert-warning(role="status")
                        strong Recalculation required.
                        |  Saved changes have not been applied to the shares. Preview the updated amounts before recalculating, or roll back the pool changes. Payments can still be recorded against the previous shares.
                .d-flex.flex-wrap.gap-2.mb-3(role="group" aria-label=`Manage ${pool.name}`)
                    button.btn.btn-primary.btn-sm(type="button" data-bs-toggle="modal" data-bs-target=`#pool-${pool.id}-expense`)
                        i.bi.bi-plus-circle.me-1(aria-hidden="true")
                        | Add invoice / amount
                    button.btn.btn-outline-light.btn-sm(type="button" data-bs-toggle="modal" data-bs-target=`#pool-${pool.id}-settings`) Pool settings
                    button.btn.btn-outline-light.btn-sm(type="button" data-bs-toggle="modal" data-bs-target=`#pool-${pool.id}-participants`) Participants & factors
                    button.btn.btn-outline-light.btn-sm(type="button" data-bs-toggle="modal" data-bs-target=`#pool-${pool.id}-adjustments`) Surcharges & rebates
                    button.btn.btn-outline-light.btn-sm.manage-takeovers(type="button" data-id=pool.id data-mode="admin") Manage takeovers
                +poolStats(pool)
                +poolTakeoverSummary(pool, participants)
                details.mt-3(open=newCount > 0 || pool.status === 'OPEN')
                    summary.fw-semibold Invoices (#{(pool.invoices || []).length})#{newCount ? ` · ${newCount} awaiting review` : ''}
                    +invoiceOverview('admin', {pool: pool, participants: participants, eventId: ev.id})
                if pool.status === 'CLOSED'
                    .mt-4
                        +poolShareSection(pool, participants, ev.id)
                .border-top.border-secondary-subtle.mt-4.pt-3.d-flex.flex-wrap.justify-content-between.align-items-center.gap-3
                    .flex-grow-1
                        strong #{pool.status === 'OPEN' ? 'Ready to calculate shares?' : 'Update the calculated shares'}
                        p.text-secondary.small.mb-0 #{pool.status === 'OPEN' ? 'Review invoices, attendance, and saved allocation settings before closing.' : 'Preview the updated shares and carry recorded payments forward. Nothing changes until you confirm.'}
                    .d-flex.flex-wrap.gap-2
                        if pool.status === 'CLOSED'
                            button.btn.btn-outline-info.pool-open-notify(type="button" data-id=pool.id data-bs-toggle="modal" data-bs-target=`#pool-${pool.id}-notify`) Send settlement emails
                        button.btn.btn-warning.pool-open-calculation(type="button" data-id=pool.id data-bs-toggle="modal" data-bs-target=`#pool-${pool.id}-calculation`) #{pool.status === 'OPEN' ? 'Preview calculation' : 'Recalculate pool'}
                if pool.status === 'CLOSED' && pool.needsRecalculation
                    .d-flex.flex-wrap.align-items-center.gap-2.mt-3
                        button.btn.btn-outline-light(type="button" data-bs-toggle="modal" data-bs-target=`#pool-${pool.id}-rollback` disabled=!pool.calculationSnapshot) Roll back pool changes
                        if !pool.calculationSnapshot
                            small.text-secondary Rollback becomes available after this pool's next successful calculation.

mixin poolManagementModals(ev, pool, participants)
    +poolEditModal(pool, 'expense', 'Add invoice / amount')
        form.pool-expense-form(data-api=`/api/event/${ev.id}/invoice-pools/${pool.id}/invoices/organizer` data-pool=pool.id data-pool-status=pool.status enctype="multipart/form-data")
            p.small Add a shared pool expense without registering for the event. It is accepted immediately and included in the pool costs. It does not reimburse a participant, even if you attend the event.
            if pool.status === 'CLOSED'
                p.text-warning.small This adds a saved cost. Existing shares stay unchanged until you recalculate the pool.
            .mb-3
                label.form-label(for=`pool-${pool.id}-expense-amount`) Amount
                input.form-control.text-bg-dark(id=`pool-${pool.id}-expense-amount` type="number" name="amount" min="0.01" max="99999999.99" step="0.01" required inputmode="decimal")
            .mb-3
                label.form-label(for=`pool-${pool.id}-expense-description`) Description
                textarea.form-control.text-bg-dark(id=`pool-${pool.id}-expense-description` name="description" rows="3" maxlength="4000" required)
            .mb-3
                label.form-label(for=`pool-${pool.id}-expense-proof`) Proof (optional)
                input.form-control.text-bg-dark(id=`pool-${pool.id}-expense-proof` type="file" name="proof" accept="image/jpeg,image/png,image/gif,application/pdf" aria-describedby=`pool-${pool.id}-expense-proof-help`)
                small.text-secondary(id=`pool-${pool.id}-expense-proof-help`) Attach an image or PDF receipt, or leave this empty to record an amount only.
            .pool-form-status.mt-3(role="status" aria-live="polite")
            .d-flex.justify-content-end.flex-wrap.gap-2.mt-3
                button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
                button.btn.btn-primary(type="submit") Add expense
    +poolEditModal(pool, 'settings', 'Pool settings')
        +poolBaseSettingsForm(ev, pool)
    +poolEditModal(pool, 'participants', 'Participants & factors')
        +poolAssignmentsForm(ev, pool, participants)
    +poolEditModal(pool, 'adjustments', 'Surcharges & rebates')
        +poolAdjustmentSection(ev, pool, participants)
    +poolEditModal(pool, 'calculation', 'Calculation preview')
        .pool-unsaved-warning.status-notice.alert-warning(hidden role="status") Save or discard your pending edits in the settings, participant, or adjustment dialog before previewing.
        .pool-form-status(role="status" aria-live="polite" tabindex="-1")
        p.small Review the saved allocation settings and every payer's result below. This preview does not change shares or send emails.
        if pool.status === 'CLOSED'
            p.text-info.small Recorded payments and refunds are carried forward. Someone who has already paid may owe only the difference or be due a refund.
        .pool-preview-summary.row.g-3.mb-3(hidden data-pool-preview-summary)
            .col-6
                small.text-secondary.d-block Remaining to collect
                strong.fs-4(data-pool-preview-outstanding) 0.00
            .col-6
                small.text-secondary.d-block Refunds to pay
                strong.fs-4(data-pool-preview-refunds) 0.00
        details.pool-preview-reconciliation.mb-3(hidden data-pool-preview-reconciliation)
            summary.text-info How the totals add up
            .table-responsive.mt-2
                table.table.table-dark.table-sm.mb-0
                    tbody
                        tr
                            th(scope="row") Shared invoice costs
                            td.text-end(data-preview-total="invoiceAmount") 0.00
                        tr
                            th(scope="row") Redistributed adjustments
                            td.text-end(data-preview-total="redistributedAmount") 0.00
                        tr
                            th(scope="row") Base to distribute
                            td.text-end(data-preview-total="distributableAmount") 0.00
                        tr
                            th(scope="row") Rounded base total
                            td.text-end(data-preview-total="allocatedBaseAmount") 0.00
                        tr
                            th(scope="row") Rounding difference
                            td.text-end(data-preview-total="roundingDifference") 0.00
                        tr
                            th(scope="row") Participant adjustments
                            td.text-end(data-preview-total="adjustmentAmount") 0.00
                        tr
                            th(scope="row") Allocated costs
                            td.text-end(data-preview-total="grossAmount") 0.00
                        tr
                            th(scope="row") Invoice reimbursements
                            td.text-end(data-preview-total="invoiceCreditAmount") 0.00
                        tr
                            th(scope="row") Expected net before rounding
                            td.text-end(data-preview-total="expectedNetAmount") 0.00
                        tr
                            th(scope="row") Net calculated shares
                            td.text-end(data-preview-total="calculatedAmount") 0.00
                        tr
                            th(scope="row") Previously settled
                            td.text-end(data-preview-total="paymentCreditAmount") 0.00
                        tr
                            th(scope="row") Net remaining balance
                            td.text-end.fw-bold(data-preview-total="remainingAmount") 0.00
            p.text-secondary.small.mt-2.mb-1 Shared invoice costs minus redistributed adjustments gives the base to distribute. Rounded base plus participant adjustments gives allocated costs. Invoice reimbursements are accepted personal invoices deducted from those costs; they are not extra charges.
            p.text-secondary.small.mb-1 Previously settled payments are then deducted from the net calculated shares. A positive net remaining balance is money to collect; a negative balance is money to pay out.
            p.text-secondary.small.mb-0(data-preview-rounding-note) Each base share is rounded up or down to cents according to Pool settings. This can leave a small surplus or shortfall; equal unrounded base shares receive the same rounded amount.
        .pool-preview-frame.mb-3(hidden data-pool-preview-table)
            .table-responsive.pool-preview-table
                table.table.table-dark.table-sm.align-middle.mb-0
                    caption.visually-hidden Preview of the next calculation, including previous settlement
                    thead
                        tr
                            th(scope="col") Payer
                            th(scope="col") Base
                            th(scope="col") Adjustments
                            th(scope="col") Invoice credit
                            th(scope="col") Previously settled
                            th(scope="col") Remaining due / refund
                    tbody(data-pool-preview-rows)
        p.text-secondary.small Positive settlement credits are payments already received; negative credits are refunds already paid out. The remaining amount is what is still owed after those credits.
        .form-check.form-switch.mt-3
            input.form-check-input(type="checkbox" name="sendEmails" id=`pool-${pool.id}-calculation-emails` checked=pool.sendCalculationEmails == null || !!pool.sendCalculationEmails)
            label.form-check-label(for=`pool-${pool.id}-calculation-emails`) Email participants after this calculation
        p.text-secondary.small.mt-2 This choice applies to this calculation. Change the default in Pool settings. You can also send settlement emails later.
        if pool.status === 'OPEN'
            p.text-secondary.small Confirming closes this pool to new invoice submissions.
        .d-flex.justify-content-end.flex-wrap.gap-2.mt-3
            button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
            button.btn.btn-outline-light.pool-preview-refresh(type="button" data-id=pool.id) Refresh preview
            button.btn.btn-warning(type="button" class=pool.status === 'OPEN' ? 'pool-close' : 'pool-recalculate' data-id=pool.id disabled) #{pool.status === 'OPEN' ? 'Close pool & calculate' : 'Apply recalculation'}
    if pool.status === 'CLOSED'
        +poolEditModal(pool, 'notify', 'Send settlement emails')
            p Send each payer their current calculated share, previous settlement credit, remaining amount, and paid status.
            if pool.needsRecalculation
                .status-notice.alert-warning These emails describe the previous calculation. Saved pool changes will only be included after recalculation.
            p.text-secondary.small Only payers with an email address receive a message. Sending again sends another email; it does not change the calculation or payment records.
            .pool-form-status(role="status" aria-live="polite" tabindex="-1")
            .d-flex.justify-content-end.flex-wrap.gap-2.mt-3
                button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
                button.btn.btn-info.pool-notify(type="button" data-id=pool.id) Send settlement emails
        if pool.needsRecalculation
            +poolEditModal(pool, 'rollback', 'Roll back pool changes')
                p Restore the pool settings, participant assignments, factors, exemptions, surcharges, rebates, and takeovers saved at the last successful calculation.
                p.fw-semibold Current share rows and all recorded payments are kept. This does not send emails.
                p.text-secondary.small Changes to event attendance, registrations, or invoices are not undone. If those inputs have changed, the pool may still require recalculation after rollback.
                .pool-form-status(role="status" aria-live="polite" tabindex="-1")
                .d-flex.justify-content-end.flex-wrap.gap-2.mt-3
                    button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
                    button.btn.btn-outline-light.pool-return(type="button" data-id=pool.id hidden) Return to pool
                    button.btn.btn-warning.pool-rollback(type="button" data-id=pool.id disabled=!pool.calculationSnapshot) Restore last calculated settings

mixin invoicePoolManageTab(ev, pools, participants)
    if pools && pools.length
        p.text-secondary.small.mb-3 Open a pool to review invoices and settlement. Use its dialogs to save allocation changes, including after closure.
        .accordion.accordion-dark#invoicePoolAccordion
            each pool in pools
                +poolManagementSection(ev, pool, participants)
        each pool in pools
            +poolManagementModals(ev, pool, participants)
    else
        p.text-secondary.mb-0 No invoice pools created yet.

//- Shared distribution selector to keep create/edit forms in sync
mixin poolDistributionSelect(name, selected, id = null)
    select.form-select.text-bg-dark(name=name id=id required)
        option(value="TIME_BASED" selected=selected === 'TIME_BASED') Distribute among days attended
        option(value="NIGHTS" selected=selected === 'NIGHTS') Distribute among nights stayed
        option(value="EQUAL" selected=selected === 'EQUAL') Distribute among participants

//- Shared base settings fields used for pool creation and later edits
mixin poolBaseSettingsFields(pool = {})
    - const selectedDistribution = pool.distributionMethod || pool.distribution || 'TIME_BASED';
    .row.g-3
        .col-md-6
            label.form-label(for=pool.id ? `poolDistribution-${pool.id}` : 'poolDistribution') Share distribution mode
            +poolDistributionSelect('distribution', selectedDistribution, pool.id ? `poolDistribution-${pool.id}` : 'poolDistribution')
        .col-md-6
            label.form-label(for=pool.id ? `poolDescription-${pool.id}` : 'poolDescription') Description
            input.form-control.text-bg-dark(
                type="text"
                name="description"
                id=pool.id ? `poolDescription-${pool.id}` : 'poolDescription'
                value=pool.description || ''
            )
        .col-12
            input(type="hidden" name="roundUpSharesConfigured" value="on")
            .form-check.form-switch
                input.form-check-input(type="checkbox" name="roundUpShares" id=pool.id ? `pool-${pool.id}-rounding` : 'poolRoundingCreate' checked=pool.roundUpShares == null || !!pool.roundUpShares)
                label.form-check-label(for=pool.id ? `pool-${pool.id}-rounding` : 'poolRoundingCreate') Round base shares up
            p.text-secondary.small.mt-2.mb-0 Selected: round each base share up to the next cent. Cleared: round down to cents. Equal unrounded base shares receive the same rounded amount. The preview shows any difference from the original total.

//- Compact editable form for the base pool parameters
mixin poolBaseSettingsForm(ev, pool)
    form.pool-base-form(data-api=`/api/event/${ev.id}/invoice-pools/${pool.id}` data-pool=pool.id data-pool-status=pool.status)
        +poolSaveNotice(pool)
        +poolBaseSettingsFields(pool)
        input(type="hidden" name="sendCalculationEmailsConfigured" value="on")
        .form-check.form-switch.mt-3
            input.form-check-input(type="checkbox" name="sendCalculationEmails" id=`pool-${pool.id}-email-default` checked=pool.sendCalculationEmails == null || !!pool.sendCalculationEmails)
            label.form-check-label(for=`pool-${pool.id}-email-default`) Send calculation emails automatically
        p.text-secondary.small.mt-2 Use this as the default when closing or recalculating the pool. You can change it in the calculation preview or send settlement emails later.
        +poolFormFooter('Save pool settings')

//- Pool creation tab content for the admin dashboard
mixin invoicePoolCreateModal(ev, participants)
    .modal.fade#poolCreateModal(tabindex="-1" aria-labelledby="poolCreateLabel" aria-hidden="true")
        .modal-dialog.modal-lg.modal-dialog-scrollable.modal-fullscreen-sm-down
            .modal-content.bg-dark.text-white
                .modal-header
                    h5.modal-title#poolCreateLabel Create a new pool
                    button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Close")
                form.pool-modal-form#poolCreateForm(data-api=`/api/event/${ev.id}/invoice-pools`)
                    .modal-body
                        .row.g-3
                            .col-md-12
                                label.form-label(for="poolName") Pool name
                                input#poolName.form-control.text-bg-dark(type="text" name="name" required maxlength="255")
                        .row.g-3.mt-0
                            .col-md-8
                                +poolBaseSettingsFields({})
                            .col-md-4
                                label.form-label.text-secondary Allocation
                                .form-check
                                    input#assignAllPools.form-check-input.pool-toggle(type="checkbox" name="assignAll" checked)
                                    label.form-check-label(for="assignAllPools") Assign to all participants
                                .form-check
                                    input#defaultPool.form-check-input.pool-toggle(type="checkbox" name="isDefault")
                                    label.form-check-label(for="defaultPool") Make this the default pool
                                small.text-secondary Default pools automatically include future participants without reopening assignments.
                                .form-check.mt-2
                                    input#subtractPersonalInvoicesCreate.form-check-input(type="checkbox" name="subtractPersonalInvoices" checked)
                                    label.form-check-label(for="subtractPersonalInvoicesCreate") Deduct submitter invoices from their share
                            .col-12
                                label.form-label(for="poolRegistrations") Limit to participants (disabled when assigned to all)
                                .assignments-list.border.border-secondary-subtle.rounded-3.p-2.bg-black.text-white#poolRegistrations
                                    if participants && participants.length
                                        each p in participants
                                            .form-check
                                                input.form-check-input(type="checkbox" name="registrations" value=p.id id=`pool-create-reg-${p.id}` disabled checked)
                                                label.form-check-label(for=`pool-create-reg-${p.id}`)= `${p.name} (${p.email})`
                                    else
                                        p.text-secondary.small.mb-0 No participants yet.
                        .pool-form-status.mt-3(role="status" aria-live="polite")
                    .modal-footer
                        button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
                        button.btn.btn-primary(type="submit")
                            i.bi.bi-plus-circle.me-1(aria-hidden="true")
                            | Add pool

//- Wrapper to tie together the manage and create tabs
mixin invoiceManagementTabs(ev, data)
    .card.mb-3.bg-dark.text-white.border-secondary-subtle
        .card-header.py-2.d-flex.flex-wrap.align-items-center.justify-content-between.gap-2
            .d-flex.align-items-center.gap-2
                i.bi.bi-receipt(aria-hidden="true")
                span Invoice pools
            button.btn.btn-primary.btn-sm(type="button" data-bs-toggle="modal" data-bs-target="#poolCreateModal")
                i.bi.bi-plus-circle.me-1(aria-hidden="true")
                | Create pool
        .card-body
            +invoicePoolManageTab(ev, data.invoicePools, data.participants || [])
    +invoicePoolCreateModal(ev, data.participants || [])
    +invoiceOrganizerActionDialogs

mixin invoiceActionDialog(id, title)
    .modal.fade.pool-edit-modal(id=id tabindex="-1" aria-labelledby=`${id}-title` aria-hidden="true")
        .modal-dialog.modal-lg.modal-dialog-scrollable.modal-fullscreen-sm-down
            .modal-content.bg-dark.text-white
                .modal-header
                    h5.modal-title(id=`${id}-title`)= title
                    button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Close")
                block

mixin invoiceOrganizerActionDialogs
    +invoiceActionDialog('invoiceEditModal', 'Correct invoice')
        form.pool-modal-form.invoice-lifecycle-form(data-action="revise")
            .modal-body
                p.fw-semibold(data-invoice-change-subject)
                p.small.text-secondary Correct the effective amount or description. The original invoice and proof remain in the history.
                .mb-3
                    label.form-label(for="invoiceEditAmount") Amount
                    input#invoiceEditAmount.form-control.text-bg-dark(type="number" name="correctedAmount" min="0.01" max="99999999.99" step="0.01" required)
                .mb-3
                    label.form-label(for="invoiceEditDescription") Description
                    textarea#invoiceEditDescription.form-control.text-bg-dark(name="correctedDescription" rows="3" maxlength="4000")
                    small.text-secondary Leave this empty to restore the original description.
                .pool-form-status(role="status" aria-live="polite")
            .modal-footer
                button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
                button.btn.btn-primary(type="submit") Continue
    +invoiceActionDialog('invoiceRejectModal', 'Reject invoice from pool')
        form.pool-modal-form.invoice-lifecycle-form(data-action="reject-accepted")
            .modal-body
                p.fw-semibold(data-invoice-change-subject)
                p.small.text-secondary Rejecting removes this accepted cost from the pool total. Its original details and proof remain in the history.
                label.form-label(for="invoiceRejectReason") Rejection reason
                textarea#invoiceRejectReason.form-control.text-bg-dark(name="rejectionReason" rows="3" maxlength="4000" required)
                .pool-form-status.mt-3(role="status" aria-live="polite")
            .modal-footer
                button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
                button.btn.btn-danger(type="submit") Continue
    +invoiceActionDialog('invoiceConfirmModal', 'Confirm invoice change')
        .modal-body
            p.fw-semibold(data-invoice-change-subject)
            div(data-invoice-change-review)
            p.text-warning.small(data-invoice-closed-warning hidden) Existing shares and payments stay unchanged. Recalculate this closed pool to apply the change to shares.
            p.small.text-secondary The change is saved only after you confirm below. Original details and proof are preserved.
            .pool-form-status(role="status" aria-live="polite")
        .modal-footer
            button.btn.btn-secondary.invoice-confirm-back(type="button") Back to edit
            button.btn.btn-warning.invoice-confirm-submit(type="button") Confirm change

mixin invoiceRetractionDialog
    +invoiceActionDialog('invoiceRetractModal', 'Retract invoice')
        .modal-body
            p.fw-semibold(data-invoice-change-subject)
            p(data-invoice-retract-description)
            p This invoice will be marked Retracted and will no longer await review. Its details and proof remain in your history.
            .pool-form-status(role="status" aria-live="polite")
        .modal-footer
            button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
            button.btn.btn-danger.invoice-retract-confirm(type="button") Confirm retraction

//- Shared takeover modal for admins/participants with a search field
mixin takeoverModal(id)
    .modal.fade.pool-edit-modal(id=id tabindex="-1" aria-labelledby=`${id}-title` aria-hidden="true")
        .modal-dialog.modal-lg.modal-dialog-scrollable.modal-fullscreen-sm-down
            .modal-content.bg-dark.text-white
                .modal-header
                    h5.modal-title(id=`${id}-title` data-takeover-title) Manage takeovers
                    button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Close")
                form.pool-modal-form#takeoverForm
                    .modal-body
                        p.text-secondary.small Choose a payer, then the participants they will cover. Each beneficiary keeps their own factor, adjustments, and invoice credit when their share is combined into the payer's result.
                        .status-notice.alert-info.small(data-takeover-status hidden)
                        .pool-takeover-selection.border.border-secondary-subtle.rounded-3.p-3.mb-3
                            strong.d-block Selected coverage
                            span.text-secondary.small(data-takeover-summary role="status" aria-live="polite") Choose a payer to manage coverage.
                        .pool-form-status(role="status" aria-live="polite" tabindex="-1")
                        .mb-3.admin-only
                            label.form-label(for="takeoverPayer") Payer
                            select#takeoverPayer.form-select.text-bg-dark(name="payerId")
                        .mb-3
                            label.form-label(for="takeoverSearch") Search participants
                            input#takeoverSearch.form-control.text-bg-dark.takeover-search(type="search" placeholder="Type to filter")
                        .takeover-beneficiaries.list-group.list-group-flush.bg-dark.border.border-secondary-subtle.rounded-3
                            // populated by JS
                    .modal-footer
                        button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close
                        button.btn.btn-primary(type="submit")
                            i.bi.bi-save.me-1(aria-hidden="true")
                            | Save changes
