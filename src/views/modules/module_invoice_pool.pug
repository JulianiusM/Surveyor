//- Common invoice pool fragments reused by admin and participant pages
include mixins/helpers.pug
//- Formulas contain already formatted values and catalog-owned labels. Render operators separately so attendance,
//- factors, credits, and signed results remain readable when a phone wraps the equation into several lines.
mixin invoiceCalculationFormula(formula)
    .invoice-calculation-formula.d-flex.flex-wrap.align-items-end.gap-2.p-3.border.border-secondary-subtle.rounded-3.bg-black(role="group" aria-label=formula.result.label)
        each term in formula.terms
            if term.operator
                span.invoice-calculation-operator.align-self-center= term.operator
            .invoice-calculation-term.d-flex.flex-column
                strong= term.value.startsWith('-') ? `(${term.value})` : term.value
                small.text-secondary= term.label
        span.invoice-calculation-operator.align-self-center= '='
        .invoice-calculation-term.invoice-calculation-result.d-flex.flex-column
            strong.text-info= formula.result.value
            small.text-secondary= formula.result.label
    if formula.note
        p.small.text-secondary.mt-2.mb-0= formula.note

//- Structured explanations are pure presenter output. This mixin matches the browser renderer used by previews
//- and lazy personal breakdowns; it never derives amounts or constructs feature wording.
mixin invoiceCalculationDisplay(calculation, showTitle = true)
    .invoice-calculation(data-calculation-display)
        if showTitle
            h6.mb-2= calculation.title
        if calculation.description
            p.small.text-secondary.mb-3= calculation.description
        each section in calculation.sections
            section.invoice-calculation-section.mt-3(data-calculation-section=section.key)
                h6.mb-2= section.title
                if section.description
                    p.small.text-secondary.mb-2= section.description
                if section.items && section.items.length
                    //- Coverage rosters preserve presenter order and escape saved beneficiary names before their calculations.
                    ul.small.text-secondary.ps-3.mb-2
                        each item in section.items
                            li= item
                if section.metrics && section.metrics.length
                    dl.invoice-share-breakdown.small.mb-2
                        each metric in section.metrics
                            dt= metric.label
                            dd= metric.value
                if section.formula
                    +invoiceCalculationFormula(section.formula)

//- Organizer dialogs show saved financial components and the payer's complete concrete calculation.
//- The snapshot supplies attendance and coverage facts; editable pool inputs never rewrite this explanation.
mixin invoiceShareBreakdown(pool, share, ui, payerName = null, participants = [])
    //- The shared presenter owns both feature relevance and labels, rather than repeating financial rules in Pug.
    - const presentation = ui.share(share);
    - const snapshot = pool.calculationSnapshot;
    - const components = ui.components(share, snapshot && snapshot.explanation, snapshot && snapshot.surcharges);
    - const calculation = ui.payerCalculation(snapshot && snapshot.explanation, payerName ? {...share, payerName} : share, snapshot && snapshot.surcharges);
    - const settledShareNotice = ui.settledShareNotice(pool, share, participants);
    if settledShareNotice
        //- Applied exemption/coverage never hides the original payer's recorded transfer history.
        p.small.text-warning(data-share-settlement-history)= settledShareNotice.description
    dl.invoice-share-breakdown.small.mt-3.mb-3
        each component in components
            dt= component.label
            dd= ui.money(component.amount)
        //- A modal needs its own status beside its calculated balance; the backdrop obscures the original row.
        dt= ui.text('paymentStatus')
        dd(data-share-details-status)= presentation.statusLabel
    details.small.mb-3
        //- Every own and covered contribution is explained with its saved name, independently of audit notes.
        summary.text-info= calculation.title
        .mt-3
            +invoiceCalculationDisplay(calculation, false)
    - const notes = (share.note || '').split(' • ').filter(Boolean);
    if notes.length
        //- Retain saved attribution and user-authored notes as escaped text independently of the structured calculation.
        details.small
            summary.text-info= ui.labels.calculationNotes
            ul.ps-3.mt-2.mb-0
                each note in notes
                    li.text-secondary= note

//- Share ledgers use one set of display controls for organizer payers and a participant's pool rows.
//- personal changes the searchable item label only; the status, amount sort, and paging DOM hooks stay identical.
mixin invoiceShareLedgerControls(ui, personal = false)
    .share-ledger-controls.d-flex.flex-wrap.gap-2.mb-3
        input.form-control.form-control-sm.text-bg-dark(type="search" placeholder=ui.text(personal ? 'searchPoolsOrCalculationNotes' : 'searchPayersOrCalculationNotes') aria-label=ui.text('searchShares') data-share-search)
        select.form-select.form-select-sm.text-bg-dark(aria-label=ui.text('filterShareStatus') data-share-filter)
            option(value="")= ui.text('allStatuses')
            option(value="due")= ui.labels.due
            option(value="refund")= ui.labels.refund
            option(value="settled")= ui.labels.settledFilter
        select.form-select.form-select-sm.text-bg-dark(aria-label=ui.text(personal ? 'sortPools' : 'sortShares') data-share-sort)
            option(value="name")= ui.text(personal ? 'poolAZ' : 'payerAZ')
            option(value="amount-desc")= ui.text('amountHighToLow')
            option(value="amount-asc")= ui.text('amountLowToHigh')
        select.form-select.form-select-sm.text-bg-dark(aria-label=ui.text('sharesPerPage') data-share-page-size)
            option(value="25")= ui.text('pageSizeOption', {count: 25})
            option(value="50")= ui.text('pageSizeOption', {count: 50})
            option(value="100")= ui.text('pageSizeOption', {count: 100})

//- Paging preserves all saved rows; the empty state and feedback are shared by both ledger contexts.
mixin invoiceShareLedgerFooter(ui)
    p.text-secondary.small.mb-0.py-3.text-center(hidden data-share-empty)= ui.text('noSharesMatchTheseFilters')
    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mt-3
        small.text-secondary(data-share-page-summary role="status" aria-live="polite")
        button.btn.btn-outline-light.btn-sm(type="button" data-share-refresh)= ui.text('refreshList')
        .btn-group.btn-group-sm(role="group" aria-label=ui.text('sharePages'))
            button.btn.btn-outline-light(type="button" data-share-previous)= ui.text('previous2')
            button.btn.btn-outline-light(type="button" data-share-next)= ui.text('next')
    .pool-form-status.small(role="status" aria-live="polite" aria-atomic="true" data-share-feedback)

//- One dialog serves the complete ledger. Its content is supplied only for the selected saved payer or pool row.
mixin invoiceShareBreakdownDialog(pool, ui)
    +poolEditModal(pool, 'share-breakdown', ui.text('shareBreakdown'), ui)
        h6(data-share-details-payer)
        div(data-share-details-content)
        .d-flex.justify-content-end.mt-3
            button.btn.btn-secondary(type="button" data-bs-dismiss="modal")= ui.text('close')

//- Render saved pool.shares with participant names and the explicit ui presentation contract.
//- admin/eventId enable organizer export/actions; data-share-* hooks drive filtering and confirmed settlement.
mixin invoiceShareTable(pool, participants, admin = false, eventId = null, ui)
    //- Compute applied coverage once per ledger; row labels must not use staged edits or repeat snapshot sorting.
    - const appliedTakeovers = ui.appliedTakeovers(pool);
    if pool.shares && pool.shares.length
        .share-ledger.border.border-secondary-subtle.rounded-3.p-3(data-share-ledger)
            .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-3
                .d-flex.align-items-center.flex-wrap.gap-2
                    strong= ui.text('calculatedShares')
                    span.badge.bg-secondary= ui.text('payersCount', {count: pool.shares.length})
                if admin && eventId
                    //- Both exports include every saved payer row. The default explains an example; the compact
                    //- alternative omits that example only. Display filters never change the exported accounting.
                    - const exportUrl = `/event/${eventId}/export/invoice-pools/${pool.id}/shares`;
                    .d-flex.flex-wrap.gap-2
                        a.btn.btn-outline-light.btn-sm(href=exportUrl download aria-label=ui.text('exportNamedSharesPdfWithExample', {poolName: pool.name}))
                            i.bi.bi-file-earmark-pdf.me-1(aria-hidden="true")
                            = ui.text('exportPdfWithExample')
                        a.btn.btn-outline-light.btn-sm(href=`${exportUrl}?example=false` download aria-label=ui.text('exportNamedSharesPdfWithoutExample', {poolName: pool.name}))
                            i.bi.bi-file-earmark-pdf.me-1(aria-hidden="true")
                            = ui.text('exportPdfWithoutExample')
            p.text-secondary.small= ui.text('statusDescribesPayer')
            +invoiceShareLedgerControls(ui)
            .table-responsive.share-ledger-table
                table.table.table-dark.table-hover.align-middle.mb-0
                    caption.visually-hidden= ui.text('calculatedPayerSharesAndSettlementStatus')
                    thead
                        tr
                            th(scope="col")= ui.labels.payer
                            th(scope="col")= ui.labels.original
                            th(scope="col")= ui.text('status')
                            th(scope="col")= ui.text('calculationDetails')
                            th(scope="col")= ui.text('settlement')
                    tbody(data-share-body)
                        each share in pool.shares
                            -
                                // Saved coverage follows the applied snapshot, even while organizer edits remain pending.
                                const registrationId = share.registrationId || share.registration?.id;
                                const payerName = (participants || []).find(pt => pt.id === registrationId)?.name || ui.text('participant', {id: registrationId});
                                const missingCoverage = !ui.hasAppliedTakeoverEvidence(pool);
                                const covered = missingCoverage ? ui.text('seeSavedCalculationNotes') : appliedTakeovers
                                    .filter(t => t.payerRegistrationId === registrationId)
                                    .map(t => (participants || []).find(pt => pt.id === t.beneficiaryRegistrationId)?.name || ui.text('participant', {id: t.beneficiaryRegistrationId}))
                                    .join(', ');
                                const coveredCount = appliedTakeovers.filter(t => t.payerRegistrationId === registrationId).length;
                                // Shared presentation owns signed calculated balance and payment/refund wording.
                                const isPaid = share.isPaid === true || share.isPaid === 1;
                                const presentation = ui.share(share);
                                const settledShareNotice = ui.settledShareNotice(pool, share, participants);
                                const amount = presentation.originalBalance;
                                const shareStatus = presentation.status;
                                const hasSettlementAction = admin && amount !== 0;
                                const searchText = `${payerName} ${covered} ${share.note || ''}`.toLowerCase();
                                // Existing numeric components allow the owner to refresh recorded-transfer totals after confirmation.
                                const financialShare = {
                                    registrationId,
                                    baseShareAmount: share.baseShareAmount,
                                    extraAmount: share.extraAmount,
                                    invoiceCreditAmount: share.invoiceCreditAmount,
                                    paymentCreditAmount: share.paymentCreditAmount ?? 0,
                                    shareAmount: share.shareAmount,
                                    isPaid,
                                };
                            tr(data-share-row data-share-name=payerName data-share-search=searchText data-share-amount=amount data-share-status=shareStatus data-share-financial=admin ? JSON.stringify(financialShare) : null)
                                td(data-label=ui.text('payer'))
                                    strong.d-block= payerName
                                    //- Keep the ordinary ownership caption for every saved row, including later exemptions.
                                    //- An applied responsibility notice belongs to the independent settlement status below.
                                    small.text-secondary= missingCoverage ? ui.text('coverageInSavedNotes') : coveredCount ? ui.text('otherParticipantsCovered', {count: coveredCount}) : ui.text('ownShare')
                                td(data-label=ui.labels.original)
                                    //- The calculated balance stays visible regardless of the settlement marker.
                                    strong.fs-5(data-share-balance)= ui.money(presentation.originalBalance)
                                    //- Restore the role-specific description without calculating or displaying another amount.
                                    small.d-block.text-secondary(data-share-balance-note)= ui.balanceCaption(share, admin ? 'organizer' : 'participant')
                                td(data-label=ui.text('status'))
                                    span.badge(data-share-state class=shareStatus === 'settled' ? 'bg-success' : shareStatus === 'refund' ? 'bg-info text-dark' : 'bg-warning text-dark')= presentation.statusLabel
                                    if settledShareNotice
                                        //- This retained-history indicator follows frozen calculation inputs, separately from payment status.
                                        small.text-warning.d-block.mt-1(data-share-settlement-history)= settledShareNotice.label
                                td(data-label=ui.text('calculationDetails'))
                                    button.btn.btn-outline-light.btn-sm.share-details-open(type="button" data-bs-toggle="modal" data-bs-target=`#pool-${pool.id}-share-breakdown` aria-label=ui.text('viewBreakdownFor', {payerName: payerName}))
                                        i.bi.bi-calculator.me-1(aria-hidden="true")
                                        = ui.text('viewBreakdown')
                                    template(data-share-details)
                                        +invoiceShareBreakdown(pool, share, ui, payerName, participants)
                                td(data-label=ui.text('settlement') class=hasSettlementAction ? null : 'd-none d-lg-table-cell')
                                    //- Preserve the desktop column, but omit an empty action slot from tablet/mobile cards.
                                    //- A zero balance needs no transfer action; the adjacent status already describes it.
                                    if hasSettlementAction
                                        //- This compact button opens a frontend review; scrolling or cancellation never sends isPaid.
                                        button.btn.btn-outline-light.btn-sm.share-settlement(type="button" data-pool=pool.id data-id=share.id data-amount=share.shareAmount data-paid=isPaid ? 'true' : 'false' autocomplete="off" aria-label=ui.text('actionForPayer', {action: presentation.actionLabel, payer: payerName}))
                                            i.bi.me-1(aria-hidden="true" class=isPaid ? 'bi-arrow-counterclockwise' : 'bi-check2-circle' data-share-settlement-icon)
                                            span(data-share-settlement-label)= presentation.actionLabel
            +invoiceShareLedgerFooter(ui)
        +invoiceShareBreakdownDialog(pool, ui)

//- pool/participants provide saved coverage; mode controls editing context, options controls the heading.
//- registrationId decorates the personal row only. ui is required and no feature state comes from globals.
mixin takeoverOverview(pool, participants, mode, options, ui, registrationId = null)
    - const showHeading = !(options && options.showHeading === false);
    if showHeading
        h6.mb-2= ui.text('takeovers')
        p.text-secondary.small.mb-2= ui.text('assignWhichParticipantCoversAnotherSShareCoveredParticipants')
    +poolCoverageOverview(pool, participants, mode, ui, registrationId)
    button.btn.btn-outline-light.btn-sm.manage-takeovers.align-self-end.mt-2(type="button" data-id=pool.id data-mode=mode disabled=mode === 'participant' && pool.status !== 'OPEN')
        i.bi.bi-person-check.me-1(aria-hidden="true")
        = ui.text('manageTakeovers2')

//- Reuse assigned pools and the explicitly passed participant registration; keep chooser drafts separate from saved coverage.
mixin participantTakeoverList(pools, participants, ui, registrationId = null)
    - const participantList = participants || [];
    if pools && pools.length
        h6.mt-4= ui.text('takeovers')
        p.text-secondary.small.mb-2= ui.text('chooseWhoseShareYouWillCoverInEachPool')
        each pool in pools
            - const assignments = pool.assignments || []
            - const assignedIds = pool.assignAll ? participantList.map(p => p.id) : (pool.assignments || []).map(a => a.registration?.id)
            //- Participant readers see applied coverage; pending organizer choices are not yet their responsibilities.
            - const takeoverData = ui.appliedTakeovers(pool)
            - const appliedPool = {...pool, takeovers: takeoverData, needsRecalculation: false}
            .border.border-secondary-subtle.rounded-3.p-3.mb-2(data-pool=pool.id data-pool-name=pool.name data-pool-status=pool.status data-assigned=JSON.stringify(assignedIds) data-takeovers=JSON.stringify(takeoverData))
                .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2
                    .d-flex.flex-column
                        strong= pool.name
                        small.text-secondary= pool.assignAll ? ui.text('allParticipantsCovered') : ui.text('participantsCovered', {count: assignments.length})
                    if !ui.hasAppliedTakeoverEvidence(pool)
                        p.text-secondary.small.mb-0= ui.text('appliedTakeoversUnavailable')
                    else
                        +takeoverOverview(appliedPool, participantList, 'participant', {showHeading: false}, ui, registrationId)

//- Render a single proof link, keeping the markup consistent across admin/participant views
mixin invoiceProofLink(inv, eventId, poolId, ui)
    if inv.proofPath
        a.text-info(href=`/api/event/${eventId}/invoice-pools/${poolId}/invoices/${inv.id}/proof` target="_blank" rel="noopener noreferrer" title=inv.proofOriginalName || ui.text('invoiceProof'))
            i.bi.bi-file-earmark-text.me-1(aria-hidden="true")
            = ui.text('viewProof')
    else
        //- Organizer entry keeps optional proof even when a participant paid. Existing original-name evidence still
        //- distinguishes an expired upload from a receipt that was never attached; participant submissions require proof.
        - const optionalProof = ui.isOrganizerInvoice(inv);
        span.text-secondary= optionalProof && !inv.proofOriginalName ? ui.text('noProofAttached') : ui.text('proofExpired')

//- Human-readable status badge shared by administration and participant history.
mixin invoiceStatusBadge(status, ui)
    if status === 'NEW'
        span.badge.bg-warning.text-dark= ui.labels.awaitingReview
    else if status === 'APPROVED'
        span.badge.bg-success= ui.labels.accepted
    else if status === 'REJECTED'
        span.badge.bg-danger= ui.labels.rejected
    else if status === 'RETRACTED'
        span.badge.bg-secondary= ui.labels.retracted
    else
        span.badge.bg-secondary= ui.labels.closed

//- Search, status filter, and paging controls shared by ledgers with hundreds of rows.
mixin invoiceLedgerToolbar(title, invoices, ui)
    - const newCount = invoices.filter(invoice => invoice.status === 'NEW').length
    - const acceptedCount = invoices.filter(invoice => invoice.status === 'APPROVED').length
    - const rejectedCount = invoices.filter(invoice => invoice.status === 'REJECTED').length
    - const closedCount = invoices.filter(invoice => invoice.status === 'CLOSED').length
    - const retractedCount = invoices.filter(invoice => invoice.status === 'RETRACTED').length
    .invoice-ledger-toolbar.d-flex.flex-wrap.align-items-center.justify-content-between.gap-2.mb-2
        .d-flex.flex-wrap.align-items-center.gap-2
            h6.mb-0= title
            span.badge.bg-secondary= ui.text('total', {length: invoices.length})
            if newCount
                span.badge.bg-warning.text-dark= ui.text('countedLabel', {count: newCount, label: ui.labels.awaitingReview})
            if acceptedCount
                span.badge.bg-success= ui.text('countedLabel', {count: acceptedCount, label: ui.labels.accepted})
            if rejectedCount
                span.badge.bg-danger= ui.text('countedLabel', {count: rejectedCount, label: ui.labels.rejected})
            if closedCount
                span.badge.bg-secondary= ui.text('countedLabel', {count: closedCount, label: ui.labels.closed})
            if retractedCount
                span.badge.bg-secondary= ui.text('countedLabel', {count: retractedCount, label: ui.labels.retracted})
        .invoice-ledger-controls.d-flex.flex-wrap.gap-2
            input.form-control.form-control-sm.text-bg-dark.invoice-ledger-search(type="search" data-invoice-search-input placeholder=ui.text('searchInvoices') aria-label=ui.text('searchInvoices'))
            select.form-select.form-select-sm.text-bg-dark(data-invoice-status-filter aria-label=ui.text('filterInvoiceStatus'))
                option(value="")= ui.text('allStatuses')
                option(value="NEW")= ui.labels.awaitingReview
                option(value="APPROVED")= ui.labels.accepted
                option(value="REJECTED")= ui.labels.rejected
                option(value="CLOSED")= ui.labels.closed
                option(value="RETRACTED")= ui.labels.retracted
            select.form-select.form-select-sm.text-bg-dark(data-invoice-page-size aria-label=ui.text('invoicesPerPage'))
                option(value="25")= ui.text('pageSizeOption', {count: 25})
                option(value="50")= ui.text('pageSizeOption', {count: 50})
                option(value="100")= ui.text('pageSizeOption', {count: 100})

mixin invoiceLedgerFooter(ui)
    .invoice-ledger-footer.d-flex.flex-wrap.align-items-center.justify-content-between.gap-2.mt-2
        small.text-secondary(data-invoice-page-summary)
        .btn-group.btn-group-sm(role="group" aria-label=ui.text('invoicePages'))
            button.btn.btn-outline-light(type="button" data-invoice-page-previous)
                i.bi.bi-chevron-left.me-1(aria-hidden="true")
                = ui.text('previous2')
            button.btn.btn-outline-light(type="button" data-invoice-page-next)
                = ui.text('next')
                i.bi.bi-chevron-right.ms-1(aria-hidden="true")

//- pool.invoices is the saved audit trail; eventId/participants provide proof routes and attribution, ui provides all text.
//- data-invoice-row and stable amount hooks feed display filters and captured frontend reviews, never authorization.
mixin adminInvoiceOverview(pool, eventId, participants, ui)
    - const invoices = [...(pool.invoices || [])].sort((left, right) => new Date((right.track && right.track.createdAt) || 0).getTime() - new Date((left.track && left.track.createdAt) || 0).getTime())
    if invoices.length
        .invoice-ledger.border.border-secondary-subtle.rounded-3.bg-black.p-3.mt-3(data-invoice-ledger)
            +invoiceLedgerToolbar(ui.text('invoiceAdministration'), invoices, ui)
            .table-responsive.invoice-ledger-table
                table.table.table-dark.table-hover.align-middle.mb-0
                    thead
                        tr
                            th= ui.text('invoice2')
                            th= ui.text('participantSource')
                            th= ui.text('submittedDetails')
                            th= ui.text('organizerReview')
                            th= ui.text('status')
                            th= ui.text('proof')
                            th= ui.text('actions')
                    tbody
                        each inv in invoices
                            - const participant = (participants || []).find(row => row.id === inv.registrationId)
                            - const isPoolExpense = inv.registrationId == null
                            //- Registration describes who paid; creator audit remains independent for organizer-entered participant invoices.
                            - const isOrganizerRecorded = ui.isOrganizerInvoice(inv)
                            - const recorderName = inv.recordedByName || inv.recordedByProfile?.name || ui.text('organizer')
                            - const participantName = isPoolExpense ? recorderName : (participant && participant.name) || ui.text('participant', {id: inv.registrationId})
                            - const participantEmail = (participant && participant.email) || ''
                            - const searchText = `${inv.id} ${isPoolExpense ? ui.text('poolExpense') : ''} ${participantName} ${isOrganizerRecorded ? recorderName : ''} ${participantEmail} ${inv.amount} ${inv.description || ''} ${inv.correctedAmount || ''} ${inv.correctedDescription || ''} ${inv.rejectionReason || ''}`.toLowerCase()
                            - const createdAt = inv.track && inv.track.createdAt
                            tr(data-invoice-row data-invoice-status=inv.status data-invoice-search=searchText)
                                td(data-label=ui.text('invoice2'))
                                    strong= ui.text('invoiceReference', {id: inv.id})
                                    small.text-secondary.d-block= ui.text(isOrganizerRecorded ? 'recordedDate' : 'submittedDate', {date: fmtInvoiceDate(createdAt)})
                                td(data-label=ui.text('participantSource'))
                                    strong.d-block= isPoolExpense ? ui.text('poolExpense') : participantName
                                    if isOrganizerRecorded
                                        //- Display the immutable recorder name even when this invoice belongs to a participant's history.
                                        small.text-secondary.d-block= ui.text('recordedBy', {participantName: recorderName})
                                    if participantEmail && participantEmail !== '—'
                                        small.text-secondary.d-block= participantEmail
                                td.invoice-cell-wide(data-label=ui.text('submittedDetails'))
                                    strong.d-block(data-invoice-submitted-amount)= fmtMoney(inv.amount)
                                    small.text-secondary.invoice-description= inv.description || ui.text('noDescription')
                                td.invoice-cell-wide(data-label=ui.text('organizerReview'))
                                    if inv.status === 'NEW'
                                        .invoice-review-fields
                                            label.form-label.small.mb-1= ui.text('correctedAmount2')
                                            input.form-control.form-control-sm.text-bg-dark.invoice-corrected-amount(type="number" min="0.01" step="0.01" placeholder=ui.text('keep', {fmtMoney: fmtMoney(inv.amount)}) aria-label=ui.text('correctedAmountForInvoice', {id: inv.id}))
                                            label.form-label.small.mt-2.mb-1= ui.text('correctedDescription2')
                                            textarea.form-control.form-control-sm.text-bg-dark.invoice-corrected-description(rows="2" maxlength="4000" placeholder=ui.text('leaveBlankToKeepSubmittedDescription') aria-label=ui.text('correctedDescriptionForInvoice', {id: inv.id}))
                                            label.form-label.small.mt-2.mb-1= ui.text('rejectionReason')
                                            textarea.form-control.form-control-sm.text-bg-dark.invoice-rejection-reason(rows="2" maxlength="4000" placeholder=ui.text('requiredWhenRejecting') aria-label=ui.text('rejectionReasonForInvoice', {id: inv.id}))
                                    else if inv.correctedAmount || inv.correctedDescription
                                        if inv.correctedAmount
                                            strong.d-block= fmtMoney(inv.correctedAmount)
                                            small.text-secondary.d-block= ui.text('original2', {fmtMoney: fmtMoney(inv.amount)})
                                        if inv.correctedDescription
                                            small.d-block.mt-1= inv.correctedDescription
                                    else
                                        span.text-secondary.small= ui.text('noCorrections')
                                td(data-label=ui.text('status'))
                                    +invoiceStatusBadge(inv.status, ui)
                                    if inv.rejectionReason
                                        small.text-danger-emphasis.d-block.mt-2= inv.rejectionReason
                                td(data-label=ui.text('proof'))
                                    +invoiceProofLink(inv, eventId, pool.id, ui)
                                td.invoice-cell-actions(data-label=ui.text('actions'))
                                    .d-flex.flex-wrap.gap-1
                                        if inv.status === 'NEW'
                                            button.btn.btn-success.btn-sm.invoice-approve(type="button" data-pool=pool.id data-id=inv.id)
                                                i.bi.bi-check2.me-1(aria-hidden="true")
                                                = ui.text('accept')
                                            button.btn.btn-outline-danger.btn-sm.invoice-decline(type="button" data-pool=pool.id data-id=inv.id)
                                                i.bi.bi-x-lg.me-1(aria-hidden="true")
                                                = ui.text('reject')
                                        else if inv.status === 'APPROVED' || inv.status === 'CLOSED'
                                            button.btn.btn-outline-light.btn-sm.invoice-edit-open(type="button" data-pool=pool.id data-id=inv.id data-revision=pool.calculationRevision data-amount=(inv.correctedAmount != null ? inv.correctedAmount : inv.amount) data-description=(inv.correctedDescription != null ? inv.correctedDescription : (inv.description || '')) data-original-description=inv.description data-pool-status=pool.status)
                                                i.bi.bi-pencil.me-1(aria-hidden="true")
                                                = ui.text('correct')
                                            button.btn.btn-outline-danger.btn-sm.invoice-reject-open(type="button" data-pool=pool.id data-id=inv.id data-revision=pool.calculationRevision data-amount=(inv.correctedAmount != null ? inv.correctedAmount : inv.amount) data-description=(inv.correctedDescription != null ? inv.correctedDescription : (inv.description || '')) data-pool-status=pool.status)
                                                i.bi.bi-x-circle.me-1(aria-hidden="true")
                                                = ui.text('rejectFromPool')
                                            if inv.status === 'APPROVED'
                                                button.btn.btn-outline-light.btn-sm.invoice-close(type="button" data-pool=pool.id data-id=inv.id)
                                                    i.bi.bi-check2-circle.me-1(aria-hidden="true")
                                                    = ui.text('close')
                                        else
                                            span.text-secondary.small= ui.text('noActions')
            .invoice-ledger-empty.text-secondary.small.py-3.text-center(hidden data-invoice-empty)= ui.text('noInvoicesMatchTheseFilters')
            +invoiceLedgerFooter(ui)
    else
        p.text-secondary.mb-0.mt-3= ui.text('noInvoicesYet')

//- invoices belongs to the authenticated participant; pools/eventId resolve names and proof links, ui owns presentation.
//- Keep accepted corrections, rejections, and retractions visible as escaped evidence in the same audit ledger.
mixin participantInvoiceOverview(invoices, pools, eventId, ui)
    - const orderedInvoices = [...(invoices || [])].sort((left, right) => new Date((right.track && right.track.createdAt) || 0).getTime() - new Date((left.track && left.track.createdAt) || 0).getTime())
    if orderedInvoices.length
        .invoice-ledger.border.border-secondary-subtle.rounded-3.bg-black.p-3.mt-3(data-invoice-ledger)
            +invoiceLedgerToolbar(ui.text('yourInvoiceHistory'), orderedInvoices, ui)
            .table-responsive.invoice-ledger-table
                table.table.table-dark.table-hover.align-middle.mb-0
                    thead
                        tr
                            th= ui.text('invoice2')
                            th= ui.text('pool')
                            th= ui.text('amount')
                            th= ui.text('description')
                            th= ui.text('status')
                            th= ui.text('proof')
                            th= ui.text('actions')
                    tbody
                        each inv in orderedInvoices
                            - const historyPool = pools.find(pool => pool.id === inv.poolId) || inv.pool
                            - const poolName = historyPool?.name || ui.text('archivedPool')
                            - const recorderName = ui.isOrganizerInvoice(inv) ? inv.recordedByName || inv.recordedByProfile?.name || ui.text('organizer') : ''
                            - const searchText = `${inv.id} ${poolName} ${recorderName} ${inv.amount} ${inv.description || ''} ${inv.correctedAmount || ''} ${inv.correctedDescription || ''} ${inv.rejectionReason || ''}`.toLowerCase()
                            - const createdAt = inv.track && inv.track.createdAt
                            tr(data-invoice-row data-invoice-status=inv.status data-invoice-search=searchText)
                                td(data-label=ui.text('invoice2'))
                                    strong= ui.text('invoiceReference', {id: inv.id})
                                    small.text-secondary.d-block= fmtInvoiceDate(createdAt)
                                    if recorderName
                                        //- Paid-by attribution grants ordinary own history without misrepresenting its organizer creator.
                                        small.text-secondary.d-block= ui.text('recordedBy', {participantName: recorderName})
                                td(data-label=ui.text('pool'))= poolName
                                td(data-label=ui.text('amount'))
                                    strong.d-block= fmtMoney(inv.correctedAmount || inv.amount)
                                    if inv.correctedAmount
                                        small.text-secondary= ui.text('original2', {fmtMoney: fmtMoney(inv.amount)})
                                td.invoice-cell-wide(data-label=ui.text('description'))
                                    span.d-block= inv.correctedDescription || inv.description || ui.text('noDescription')
                                    if inv.correctedDescription && inv.description
                                        small.text-secondary.d-block= ui.text('original3', {description: inv.description})
                                td(data-label=ui.text('status'))
                                    +invoiceStatusBadge(inv.status, ui)
                                    if inv.rejectionReason
                                        small.text-danger-emphasis.d-block.mt-2
                                            strong= ui.text('reason')
                                            = inv.rejectionReason
                                td(data-label=ui.text('proof'))
                                    +invoiceProofLink(inv, eventId, inv.poolId, ui)
                                td.invoice-cell-actions(data-label=ui.text('actions'))
                                    if inv.status === 'NEW'
                                        button.btn.btn-outline-danger.btn-sm.invoice-retract-open(type="button" data-pool=inv.poolId data-id=inv.id data-revision=(historyPool && historyPool.calculationRevision) data-amount=inv.amount data-description=inv.description)
                                            i.bi.bi-arrow-counterclockwise.me-1(aria-hidden="true")
                                            = ui.text('retract')
                                    else if inv.status === 'APPROVED'
                                        button.btn.btn-sm.btn-outline-success.invoice-close-self(type="button" data-pool=inv.poolId data-id=inv.id)
                                            i.bi.bi-check2-circle.me-1(aria-hidden="true")
                                            = ui.text('close')
                                    else
                                        span.text-secondary.small= ui.text('noActions')
            .invoice-ledger-empty.text-secondary.small.py-3.text-center(hidden data-invoice-empty)= ui.text('noInvoicesMatchTheseFilters')
            +invoiceLedgerFooter(ui)
    else
        p.text-secondary.small.mb-0= ui.text('youHaveNotSubmittedAnyInvoicesYet')

//- Invoice overview that adapts to admin and participant needs
mixin invoiceOverview(mode, options, ui)
    - const pools = options?.pools || [];
    - const eventId = options?.eventId;
    - const invoices = options?.invoices;
    if mode === 'admin' && options.pool
        +adminInvoiceOverview(options.pool, eventId, options.participants || [], ui)
    else if mode === 'participant'
        +participantInvoiceOverview(invoices || [], pools, eventId, ui)

//- eventId/pools provide the existing submission endpoint and eligible choices; invoices/allPools supply saved history.
//- mode selects the established rendering branch. The invoice-submission binder owns one upload and its recovery feedback.
mixin invoiceSubmission(eventId, pools, mode, invoices, allPools = [], ui)
    - const hasPools = pools && pools.length;
    - const overviewPools = [...new Map([...(allPools || []), ...(pools || [])].map(pool => [pool.id, pool])).values()];
    .accordion.accordion-dark.mb-3#invoiceSubmission
        .accordion-item.bg-dark.text-white.border-secondary-subtle
            h2.accordion-header
                button.accordion-button.collapsed.text-white(type="button" data-bs-toggle="collapse" data-bs-target="#invoicePoolCollapse" aria-expanded="false" aria-controls="invoicePoolCollapse")
                    i.bi.bi-receipt.me-2(aria-hidden="true")
                    = ui.text('submitAnInvoiceHistory')
            #invoicePoolCollapse.accordion-collapse.collapse
                .accordion-body
                    if hasPools
                        form#invoiceSubmitForm(data-api=`/api/event/${eventId}/invoice-pools/${pools[0].id}/submit` enctype="multipart/form-data")
                            fieldset.border-0.p-0.m-0(data-invoice-fields)
                                legend.visually-hidden= ui.text('invoiceDetailsAndProof')
                                .row.g-2
                                    .col-md-4
                                        label.form-label(for="invoicePool")= ui.text('choosePool')
                                        select#invoicePool.form-select.text-bg-dark(name="poolId" required)
                                            each pool in pools
                                                option(value=pool.id)= pool.name
                                    .col-md-4
                                        label.form-label(for="invoiceAmount")= ui.text('amount')
                                        input#invoiceAmount.form-control.text-bg-dark(type="number" name="amount" step="0.01" min="0.01" required)
                                    .col-md-4
                                        label.form-label(for="invoiceDescription")= ui.text('description')
                                        input#invoiceDescription.form-control.text-bg-dark(type="text" name="description")
                                    .col-12
                                        label.form-label(for="invoiceProof")= ui.text('proofImageOrPDF')
                                        input#invoiceProof.form-control.text-bg-dark(type="file" name="proof" accept="image/jpeg,image/png,image/gif,application/pdf" required)
                            .mt-3(data-invoice-feedback hidden)
                                #invoiceSubmitStatus.alert.alert-info.mb-2(data-invoice-status role="status" aria-live="polite" aria-atomic="true" tabindex="-1")
                                .progress.mb-2(data-invoice-progress hidden role="progressbar" aria-label=ui.text('invoiceUploadProgress') aria-valuemin="0" aria-valuemax="100")
                                    .progress-bar.progress-bar-striped.progress-bar-animated(data-invoice-progress-bar style="width: 100%")
                                button.btn.btn-outline-light.btn-sm(type="button" data-invoice-history hidden)= ui.text('viewInvoiceHistory')
                            .d-flex.justify-content-end.mt-2
                                button.btn.btn-primary(type="submit" aria-describedby="invoiceSubmitStatus")
                                    i.bi.bi-cloud-upload.me-1(aria-hidden="true")
                                    = ui.text('submitInvoice')
                    else
                        .alert.alert-info(role="status")
                            i.bi.bi-info-circle.me-2(aria-hidden="true")
                            = ui.text('noOpenPoolsForSubmissionsRightNow')
                    #invoiceHistory
                        +invoiceOverview('participant', {invoices: invoices || [], pools: overviewPools, eventId: eventId}, ui)
    +invoiceRetractionDialog(ui)

//- One read-only ledger serves every saved pool share belonging to this registration, including long histories.
//- It reuses organizer filtering, sorting, paging, responsive rows, and the single selected-row breakdown dialog.
mixin participantShareSummary(registrationId, pools, ui, participants = [])
    //- Select this registration's saved payer rows only; coverage beneficiary rows do not imply another payment.
    - const rows = [];
    - const payerName = (participants || []).find(participant => participant.id === registrationId)?.name;
    each pool in pools || []
        each share in pool.shares || []
            if share.registrationId === registrationId
                - rows.push({pool, share});
    if rows.length
        - const dialogPool = {id: `personal-shares-${registrationId}`, name: ui.text('yourPoolShares')};
        h6.mt-3= ui.text('yourPoolShares')
        .share-ledger.border.border-secondary-subtle.rounded-3.p-3(data-share-ledger data-personal-share-ledger)
            +invoiceShareLedgerControls(ui, true)
            .table-responsive.share-ledger-table(data-share-personal-table)
                table.table.table-dark.table-hover.align-middle.mb-0
                    thead
                        tr
                            th(scope="col")= ui.text('pool')
                            th(scope="col")= ui.labels.original
                            th(scope="col")= ui.text('status')
                            th(scope="col")= ui.text('calculationDetails')
                    tbody(data-share-body)
                        each row in rows
                            -
                                // Serialize only this payer's presentation, never raw pool shares or contributions.
                                // Attribute escaping and lazy text-node rendering protect saved names and notes.
                                const presentation = ui.share(row.share);
                                const snapshot = row.pool.calculationSnapshot;
                                const settledShareNotice = ui.settledShareNotice(row.pool, row.share, participants);
                                const breakdown = {
                                    components: ui.components(row.share, snapshot && snapshot.explanation, snapshot && snapshot.surcharges),
                                    calculation: ui.payerCalculation(snapshot && snapshot.explanation, {...row.share, payerName: row.share.payerName || payerName}, snapshot && snapshot.surcharges),
                                    notes: (row.share.note || '').split(' • ').filter(Boolean),
                                    statusLabel: presentation.statusLabel,
                                    needsRecalculation: !!row.pool.needsRecalculation,
                                    settledShareNotice,
                                };
                                const searchText = `${row.pool.name} ${row.pool.description || ''} ${row.share.note || ''}`.toLowerCase();
                            tr(data-share-row data-share-name=row.pool.name data-share-search=searchText data-share-amount=presentation.originalBalance data-share-status=presentation.status data-share-breakdown=JSON.stringify(breakdown))
                                td(data-label=ui.text('pool'))
                                    strong.d-block= row.pool.name
                                    if row.pool.needsRecalculation
                                        small.text-warning.d-block= ui.text('recalculationRequired')
                                td(data-label=ui.labels.original)
                                    strong.fs-5(data-share-balance)= ui.money(presentation.originalBalance)
                                    small.d-block.text-secondary(data-share-balance-note)= ui.balanceCaption(row.share, 'participant')
                                td(data-label=ui.text('status'))
                                    span.badge(data-share-state class=presentation.status === 'settled' ? 'bg-success' : presentation.status === 'refund' ? 'bg-info text-dark' : 'bg-warning text-dark')= presentation.statusLabel
                                    if settledShareNotice
                                        small.text-warning.d-block.mt-1(data-share-settlement-history)= settledShareNotice.label
                                td(data-label=ui.text('calculationDetails'))
                                    //- Only the selected pool's structured payload is rendered into the shared dialog.
                                    button.btn.btn-outline-light.btn-sm.share-details-open(type="button" data-bs-toggle="modal" data-bs-target=`#pool-${dialogPool.id}-share-breakdown` aria-label=ui.text('viewBreakdownForPool', {poolName: row.pool.name}))
                                        i.bi.bi-calculator.me-1(aria-hidden="true")
                                        = ui.text('viewBreakdown')
            +invoiceShareLedgerFooter(ui)
        +invoiceShareBreakdownDialog(dialogPool, ui)

//- Compact pool summary keeps the next action and calculation state visible.
mixin poolHeaderSummary(pool, ui)
    - const summary = ui.poolSummary(pool);
    .pool-header-summary.d-flex.align-items-center.w-100.justify-content-between.flex-wrap.gap-3
        .d-flex.flex-column.flex-grow-1
            .d-flex.align-items-center.flex-wrap.gap-2
                span.fw-semibold= pool.name
                if pool.isDefault
                    span.badge.bg-primary.text-dark= ui.text('default')
                if pool.needsRecalculation
                    span.badge.bg-warning.text-dark= ui.text('recalculationRequired')
                //- Identify the staged feature even while the pool is collapsed; pending inputs are never applied coverage.
                if ui.hasPendingTakeovers(pool)
                    span.badge.bg-warning.text-dark(data-pool-takeover-pending)= ui.text('takeoverChangesPendingIndicator')
            small.text-secondary.mb-0= pool.description || ui.text('sharedEventCosts')
        .d-flex.align-items-center.justify-content-end.flex-wrap.gap-3.me-2
            //- Collapsed pools need their most important amounts without opening each expanded summary.
            //- Distinct header hooks let settlement updates refresh both contexts without duplicating ledger selectors.
            each metric in summary.primary
                if metric.key === 'totalAmount' || metric.key === 'outstandingAmount' || metric.key === 'creditAmount'
                    .text-end
                        small.text-secondary.d-block= metric.label
                        strong(data-pool-header-outstanding=metric.key === 'outstandingAmount' ? true : null data-pool-header-refunds=metric.key === 'creditAmount' ? true : null)= ui.money(metric.amount)
            span.badge.bg-info.text-dark= ui.text(pool.status === 'OPEN' ? 'openForInvoices' : pool.status === 'ORGANIZER_ONLY' ? 'organizerInvoicesOnly' : 'closed')

//- pool contains persisted aggregate columns. Source costs appear once; transfers apply only to saved closed-pool shares.
//- ui projects stored refund magnitudes negative. Settings and derived subtotals belong to their existing detail dialogs.
mixin poolStats(pool, ui)
    - const summary = ui.poolSummary(pool);
    - const snapshot = pool.calculationSnapshot;
    - const hasSavedShares = pool.status === 'CLOSED' && (pool.shares || []).length > 0;
    - const example = hasSavedShares ? ui.calculation(snapshot && snapshot.explanation, pool.shares, snapshot && snapshot.surcharges) : null;
    .pool-totals.border.border-secondary-subtle.rounded-3.p-3.bg-black
        .row.g-3
            each metric in summary.primary
                .col-6.col-lg-3
                    small.text-secondary.d-block= metric.label
                    strong.fs-4(data-pool-outstanding=metric.key === 'outstandingAmount' ? true : null data-pool-refunds=metric.key === 'creditAmount' ? true : null)= ui.money(metric.amount)
        if summary.details.length || summary.saved.length || hasSavedShares
            //- Current source amounts and saved settlement totals remain concise factual evidence.
            //- Keep the anonymous worked example in its own disclosure so these figures are independently accessible.
            details.mt-3.small(data-pool-calculation-breakdown)
                summary.text-info= ui.text('calculationBreakdown')
                if summary.details.length
                    h6.mt-3.mb-2= ui.text('currentPoolCosts')
                    dl.invoice-share-breakdown.small.mt-3.mb-0
                        each metric in summary.details
                            dt= metric.label
                            dd= ui.money(metric.amount)
                if hasSavedShares
                    //- Costs, attendance totals, exemptions, and total weight belong to the whole saved pool.
                    //- These frozen inputs stay available independently of the illustrative payer selected below.
                    h6.mt-3.mb-2= ui.text('savedCalculationInputs')
                    +invoiceCalculationDisplay(ui.poolBreakdown(snapshot && snapshot.explanation, snapshot && snapshot.surcharges), false)
                //- This initially empty group can appear after the first confirmed transfer without rebuilding the ledger.
                //- The frozen rounding metric is retained while live recorded transfers are refreshed by the browser.
                section.mt-3(hidden=!summary.saved.length data-pool-saved-settlement data-pool-saved-rounding=JSON.stringify(summary.saved.find(metric => metric.key === 'roundingDifference') || null))
                    h6.mt-3.mb-2= ui.text('savedSettlementTotals')
                    dl.invoice-share-breakdown.small.mb-0(data-pool-saved-settlement-values)
                        each metric in summary.saved
                            dt= metric.label
                            dd= ui.money(metric.amount)
        if example && example.sections.length
            //- Only saved closed shares supply frozen example inputs; open pools explain their proposed values in preview.
            //- This sibling disclosure starts collapsed and supplies its own title rather than repeating it in the body.
            details.mt-3.small(data-pool-example-calculation)
                summary.text-info= ui.text('poolCalculationExample')
                .mt-3
                    +invoiceCalculationDisplay(example, false)
        if pool.needsRecalculation
            //- Aggregate source costs may be newer than saved shares; explain the distinction without rebuilding either.
            p.text-warning.small.mt-2.mb-0= ui.text('poolTotalsReflectSavedChangesPaymentsDueAndRefunds')

mixin poolSaveNotice(pool, ui)
    if pool.status === 'CLOSED'
        p.text-warning.small.mb-3= ui.text('saveYourChangesHereThenPreviewRecalculatePoolExisting')

mixin poolFormFooter(label, ui)
    .pool-form-status.mt-3(role="status" aria-live="polite" tabindex="-1")
    .d-flex.justify-content-end.flex-wrap.gap-2.mt-3
        button.btn.btn-outline-secondary(type="reset")= ui.text('discardEdits')
        button.btn.btn-secondary(type="button" data-bs-dismiss="modal")= ui.text('close')
        button.btn.btn-primary(type="submit")
            i.bi.bi-save.me-1(aria-hidden="true")
            = label

//- ev/pool select the existing assignment endpoint; participants supplies event membership and ui all labels/help.
//- Browser hooks track local drafts and enable factors/exemptions only for selected registrations; Save applies them.
mixin poolAssignmentsForm(ev, pool, participants, ui)
    form.pool-assignment(data-api=`/api/event/${ev.id}/invoice-pools/${pool.id}/assignments` data-pool=pool.id data-pool-status=pool.status)
        +poolSaveNotice(pool, ui)
        .form-check
            input.form-check-input.pool-toggle(type="checkbox" name="assignAll" id=`assign-${pool.id}` checked=!!pool.assignAll)
            label.form-check-label(for=`assign-${pool.id}`)= ui.text('assignToAllParticipants')
        .form-check
            input.form-check-input.pool-toggle(type="checkbox" name="isDefault" id=`default-${pool.id}` checked=!!pool.isDefault)
            label.form-check-label(for=`default-${pool.id}`)= ui.text('defaultForNewParticipants')
        .form-check
            input.form-check-input(type="checkbox" name="subtractPersonalInvoices" id=`subtract-invoices-${pool.id}` checked=!!pool.subtractPersonalInvoices)
            label.form-check-label(for=`subtract-invoices-${pool.id}`)= ui.text('deductSubmitterInvoicesFromTheirShare')
        p.text-secondary.small.mt-2= ui.text('defaultPoolsAutomaticallyIncludeFutureParticipantsEachNewParticipant')
        .border.border-secondary-subtle.rounded-3.p-3.mb-3
            strong= ui.text('shareFactors')
            p.small.mb-1= ui.text('isTheDefaultGivesMoreWeightGivesHalfThe')
            p.text-secondary.small.mb-0= ui.text('factorsApplyToTheParticipantDaysAttendedOrNights')
        label.form-label(for=`assign-search-${pool.id}`)= ui.text('searchParticipants')
        input.form-control.text-bg-dark.assignment-search.mb-2(id=`assign-search-${pool.id}` type="search" placeholder=ui.text('filterByNameOrEmail'))
        .assignments-list.pool-participant-list.border.border-secondary-subtle.rounded-3.bg-black.text-white(id=`assign-list-${pool.id}`)
            if participants && participants.length
                each p in participants
                    //- Assignment membership, factor, and exemption remain separate saved inputs, even when all are selected.
                    - const assignment = (pool.assignments || []).find(a => (a.registrationId || a.registration?.id) === p.id)
                    - const selected = pool.assignAll || !!assignment
                    - const participantFactor = assignment && assignment.factor != null ? assignment.factor : '1'
                    .pool-participant-row.p-3.border-bottom.border-secondary-subtle(data-search-text=`${String(p.name || '').toLowerCase()} ${String(p.email || '').toLowerCase()}` data-registration=p.id)
                        .form-check.mb-0
                            input.form-check-input(type="checkbox" name="registrations" value=p.id id=`pool-${pool.id}-reg-${p.id}` checked=selected disabled=!!pool.assignAll)
                            label.form-check-label(for=`pool-${pool.id}-reg-${p.id}`)
                                strong.d-block= p.name
                                small.text-secondary= p.email
                        .pool-factor-field
                            label.form-label.small.mb-1(for=`pool-${pool.id}-factor-${p.id}`)= ui.text('shareFactor')
                            input.form-control.form-control-sm.text-bg-dark(type="number" name=`factor-${p.id}` data-participant-factor=p.id id=`pool-${pool.id}-factor-${p.id}` min="0" max="1000" step="0.0001" value=participantFactor required disabled=!selected aria-describedby=`factor-help-${pool.id}`)
                        .form-check.form-switch.mb-0
                            input.form-check-input(type="checkbox" name="exemptions" value=p.id id=`pool-${pool.id}-exempt-${p.id}` checked=!!(assignment && assignment.isExempt) disabled=!selected)
                            label.form-check-label(for=`pool-${pool.id}-exempt-${p.id}`)= ui.text('exempt')
            else
                p.text-secondary.small.p-3.mb-0= ui.text('noParticipantsYet')
        p.text-secondary.small.mt-2.mb-0(id=`factor-help-${pool.id}`)= ui.text('factorsCanBeToWithUpToFourDecimal')
        +poolFormFooter(ui.text('saveParticipantsFactors'), ui)

//- Show saved signed adjustments and their participant attribution; each removal opens a review through its data hooks.
mixin poolSurchargeList(pool, participants, ui)
    if pool.surcharges && pool.surcharges.length
        ul.list-group.list-group-flush.bg-dark.mb-3
            each surcharge in pool.surcharges
                - const participant = (participants || []).find(p => p.id === surcharge.registrationId)
                - const participantName = participant && participant.name || ui.text('participant', {id: surcharge.registrationId})
                - const rebate = Number(surcharge.amount) < 0
                li.list-group-item.bg-dark.text-white.d-flex.justify-content-between.align-items-start.gap-2.px-0
                    .flex-grow-1
                        strong.me-2= participantName
                        span.badge(class=rebate ? 'bg-success' : 'bg-secondary')= ui.text('adjustmentSummary', {kind: rebate ? ui.text('rebate') : ui.text('surcharge'), amount: fmtMoney(surcharge.amount)})
                        small.d-block.text-secondary.mt-1= surcharge.subtractFromPool ? ui.text('redistributedWithinPool') : ui.text('additionalChargeCredit')
                        p.mb-0.small= surcharge.note
                    button.btn.btn-outline-danger.btn-sm.surcharge-remove(type="button" data-pool=pool.id data-id=surcharge.id aria-label=ui.text('removeFor', {kind: ui.text(rebate ? 'rebate' : 'surcharge'), name: participantName}))= ui.text('remove')
    else
