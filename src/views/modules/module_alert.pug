//- Alert module
if(status === "success")
    div(class="alert alert-success" role="alert") #{message}
if(status === "info")
    div(class="alert alert-info" role="alert") #{message}
if(status === "error")
    div(class="alert alert-danger" role="alert") #{message}
if messages && messages.error
    .alert.alert-danger(role="alert") #{messages.error}
if messages && messages.success
    .alert.alert-success(role="alert") #{messages.success}
if messages && messages.info
    .alert.alert-info(role="alert") #{messages.info}

//- Platz für JS-eingespielte Meldungen
#liveAlerts.sticky-top.mt-1
