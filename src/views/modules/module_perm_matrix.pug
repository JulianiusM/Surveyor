include module_permission_fields

//- Audience defaults are edited one audience at a time. Switching presentation preserves every
//- draft checkbox; Update permissions still sends the complete established audience payload.
//- Metadata, defaults, presets, fieldBase and API options retain the existing mixin contract.
mixin permMatrix(audiences, permMeta, defaults, presets=[], fieldBase='defaultPerms', opts={})
    - const scopeId = 'perm-scope-' + Math.random().toString(36).slice(2)
    .perm-matrix.text-bg-dark#permMatrix(data-field-base=fieldBase data-entity-section=opts.inline ? 'permissions' : undefined)
        if opts.inline
            div(data-command-feedback aria-live='polite')
        .mb-3
            label.form-label(for=scopeId) Permission audience
            select.form-select.text-bg-dark.perm-audience(id=scopeId data-entity-draft-ignore aria-label='Permission audience')
                each audience in audiences
                    option(value=audience)= audience.charAt(0).toUpperCase() + audience.slice(1)
        each audience, index in audiences
            //- This scope owns all checkbox groups for one audience; browser code never depends
            //- on rows, accordion structure, or the visibility of the current panel.
            div(data-permission-audience=audience hidden=index !== 0)
                - const audienceMask = defaults && defaults[audience] || 0
                +permissionToolbar(presets, audience)
                +permissionFields(permMeta, audienceMask, `perm-${audience}`, `${fieldBase}[${audience}][]`)
        if opts.apiUrl
            .d-flex.justify-content-end.border-top.border-secondary.pt-3
                button.btn.btn-primary.btn-perm-update(type='button' data-api=opts.apiUrl)
                    span.label Update permissions
                    span.spinner-border.spinner-border-sm.ms-2.d-none(role='status' aria-hidden='true')
    script(type='module').
        import { initPermMatrix } from "/js/modules/perm-matrix.gen.js";
        initPermMatrix();
