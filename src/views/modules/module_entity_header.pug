//- Header presentation remains read-only. Optional settings/archive are explicit page projections;
//- the single settings trigger replaces image-specific controls without becoming an authority check.
mixin entityHeader(entity, entityType, icon, permData, settings, archive)
    .card-header.p-0
        if entity.headerImg
            img.card-img-top(
                src=`/${entityType}/${entity.id}/header`
                alt=entity.title
                style="object-fit:cover;height:250px;"
            )

        .p-3.d-flex.flex-column.flex-md-row.align-items-md-center.justify-content-between.gap-3
            if settings && settings.currentEvent && settings.currentEvent.url
                .btn-group.d-md-inline.d-none
                    a.btn.btn-outline-light(href=settings.currentEvent.url)
                        i.bi.bi-arrow-left-circle.me-1(aria-hidden="true")
                        | Go to event
            else
                .d-none.d-md-inline

            h1.mb-0.text-center
                i(class=`bi ${icon} me-2` aria-hidden="true")
                | #{entity.title}

            //- Repeat parent navigation beneath the title on small devices.
            if settings && settings.currentEvent && settings.currentEvent.url
                .btn-group.d-md-none
                    a.btn.btn-outline-light(href=settings.currentEvent.url)
                        i.bi.bi-arrow-left-circle.me-1(aria-hidden="true")
                        | Go to event

            +entitySettingsButton(settings, archive)
