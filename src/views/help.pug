extends layout

block title
    .card-header.d-flex.justify-content-between.align-items-center.gap-2
        h1.card-title.mb-0
            i.bi.bi-question-circle.me-2
            | #{title}
        a.btn.btn-sm.btn-outline-light(href=`/help?locale=${data.helpLocale}`)
            i.bi.bi-house.me-1
            = data.helpText('help.home')

block content
    .row.g-3
        aside.col-lg-3
            .card.bg-dark.text-white.mb-3
                .card-header
                    h2.h5.mb-0
                        i.bi.bi-search.me-2
                        = data.helpText('help.searchTitle')
                .card-body
                    form(action="/help/search" method="get" role="search")
                        input(type="hidden" name="locale" value=data.helpLocale)
                        label.form-label.visually-hidden(for="helpSearch")= data.helpText('help.searchLabel')
                        .input-group
                            input#helpSearch.form-control.text-bg-dark(
                                type="search"
                                name="q"
                                value=(typeof searchQuery !== 'undefined' ? searchQuery : '')
                                placeholder=data.helpText('help.searchPlaceholder')
                                maxlength="100"
                                required
                            )
                            button.btn.btn-primary(type="submit" aria-label=data.helpText('help.searchTitle'))
                                i.bi.bi-search

            nav.card.bg-dark.text-white(aria-label=data.helpText('help.topics'))
                .card-header
                    h2.h5.mb-0
                        i.bi.bi-list-check.me-2
                        = data.helpText('help.topics')
                .card-body.p-0
                    each group in docsGroups
                        .help-nav-group
                            h3.help-nav-heading= group.title
                            .list-group.list-group-flush
                                each doc in group.docs
                                    - const isActive = currentDoc === doc.path
                                    a.list-group-item.list-group-item-action(
                                        href=doc.url
                                        class=isActive ? 'active bg-primary' : 'bg-dark text-white border-secondary'
                                        aria-current=isActive ? 'page' : null
                                    )= doc.title

        main.col-lg-9
            if typeof searchResults !== 'undefined'
                .card.bg-dark.text-white
                    .card-body.help-search-results
                        h2= data.helpText('help.searchResults')
                        if !searchQuery
                            p.mb-0= data.helpText('help.searchPrompt')
                        else if searchResults.length === 0
                            .status-notice.alert-info.mb-0(role="status")
                                = data.helpText('help.noMatches', {query: searchQuery})
                        else
                            p.text-secondary(role="status")= data.helpText('help.matchedCount', {count: searchResults.length, query: searchQuery})
                            .list-group
                                each result in searchResults
                                    a.list-group-item.list-group-item-action.bg-dark.text-white.border-secondary(href=result.url)
                                        .d-flex.justify-content-between.align-items-start.gap-2
                                            h3.h5.mb-1= result.title
                                            i.bi.bi-chevron-right
                                        if result.sectionTitle
                                            p.small.text-info.mb-1= data.helpText('help.inSection', {title: result.sectionTitle})
                                        p.mb-0= result.excerpt
            else
                .row.g-3
                    article(class=toc && toc.length ? 'col-xl-9' : 'col-12')
                        .card.bg-dark.text-white
                            .card-body.help-content
                                //- Trusted, release-shipped Markdown validated by helpController before rendering.
                                != content
                    if toc && toc.length
                        aside.col-xl-3
                            nav.card.bg-dark.text-white.help-toc(aria-label=data.helpText('help.onPage'))
                                .card-header
                                    h2.h6.mb-0= data.helpText('help.onPage')
                                .list-group.list-group-flush
                                    each entry in toc
                                        a.list-group-item.list-group-item-action.bg-dark.text-white.border-secondary(
                                            href=`#${entry.id}`
                                            class=entry.level === 3 ? 'help-toc-level-3' : ''
                                        )= entry.title

block link
    link(rel="stylesheet" href="/style/help.css")
