h4.mb-3 Rules & auto-assign
p.small.text-secondary.mb-4
    | Configure requirements for this plan, review coverage per participant, and generate assignment suggestions.

// Step 1 + 2: Requirements & coverage
if permData.entity.has('MANAGE_REQUIREMENTS') && data.plan.eventId
    .mb-3
        span.badge.bg-light.text-dark.me-2 Step 1
        span.fw-semibold Configure rules & defaults

    .card.text-bg-dark.border.border-secondary-subtle.mb-4#requirementPanel
        .card-header.d-flex.justify-content-between.align-items-center
            span.d-flex.align-items-center.gap-2
                i.bi.bi-gear-wide-connected
                span Requirement settings
            .d-flex.gap-2
                button.btn.btn-sm.btn-outline-secondary(type="button" data-requirements-refresh)
                    i.bi.bi-arrow-clockwise.me-1
                    | Reload
                button.btn.btn-sm.btn-success(type="button" data-requirements-save)
                    i.bi.bi-save.me-1
                    | Save settings
        .card-body
            .alert.alert-info.py-2.px-3.d-none(role="alert" data-requirements-alert)
                i.bi.bi-exclamation-circle.me-2
                span
            p.text-secondary.small.mb-3
                | Define exact required shifts and optional participant overrides.
                |  Required mode needs one saved value for every possible stay duration.

            .alert.alert-secondary.requirement-coverage-status.py-2.px-3.mb-3#requirementCoverageStatus(
                role="status"
                aria-live="polite"
            )
                .d-flex.flex-wrap.align-items-center.justify-content-between.gap-2
                    .d-flex.align-items-start.gap-2
                        i.bi.bi-bar-chart-fill.mt-1(data-coverage-icon)
                        div
                            strong.d-block(data-coverage-title) Loading coverage…
                            small(data-coverage-detail) Comparing required assignments with the slot target.
                    .d-flex.flex-wrap.gap-1(data-coverage-counts)

            form#requirementForm
                .row.g-3
                    .col-md-3
                        label.form-label(for="assignmentMode") Assignment mode
                        select#assignmentMode.form-select.form-select-sm.text-bg-dark
                            option(value="FREE") Free
                            option(value="REQUIRED") Required
                    .col-md-3
                        label.form-label(for="requiredShifts") Baseline shift requirement
                        .input-group.input-group-sm
                            input#requiredShifts.form-control.form-control-sm.text-bg-dark(type="number" min="0" placeholder="e.g. 2")
                            button.btn.btn-outline-info(type="button" data-requirements-baseline-calc)
                                i.bi.bi-calculator.me-1
                                | Calculate
                    .col-md-3
                        label.form-label(for="roundingMode") Rounding mode
                        select#roundingMode.form-select.form-select-sm.text-bg-dark
                            option(value="") None
                            option(value="CEIL") Ceil
                            option(value="ROUND") Round
                            option(value="FLOOR") Floor
                    .col-md-3
                        label.form-label(for="bindingDeadline") Binding deadline
                        input#bindingDeadline.form-control.form-control-sm.text-bg-dark(type="datetime-local" placeholder="optional")

                hr
                h6.d-flex.justify-content-between.align-items-center
                    span Stay duration requirements
                    small.text-secondary Exact shifts by days present
                p.text-secondary.small.mb-2
                    | Calculate a baseline to fill these values proportionally, then adjust any stay length as needed.
                    |  Saved values take precedence over the rounded proportional share.
                .stay-requirement-scroll.border.border-secondary-subtle.rounded.p-2
                    .stay-requirement-grid#stayRequirementList
                        span.text-secondary.small Loading stay durations…

                .form-check.form-switch.my-3
                    input#allowOverfill.form-check-input(type="checkbox" role="switch")
                    label.form-check-label(for="allowOverfill") Allow assignments beyond slot capacity
                    .form-text.text-secondary
                        | Recommendations use overfill only after normal capacity and bounded repair cannot place remaining requirements.

                .form-check.form-switch.mb-3
                    input#allowExternalAssignees.form-check-input(type="checkbox" role="switch")
                    label.form-check-label(for="allowExternalAssignees") Allow non-participants to take slots
                    .form-text.text-secondary
                        | Off by default. When enabled, profiles with access to this plan may sign up without an event registration.

                .row.g-3
                    .col-md-6
                        .form-check.form-switch
                            input#allowArrivalEvening.form-check-input(type="checkbox" role="switch")
                            label.form-check-label(for="allowArrivalEvening") Allow arrival-day evening assignments
                    .col-md-6
                        .form-check.form-switch
                            input#allowDepartureMorning.form-check-input(type="checkbox" role="switch")
                            label.form-check-label(for="allowDepartureMorning") Allow departure-day morning assignments

                hr
                h6.d-flex.justify-content-between.align-items-center
                    span Role requirements
                    small.text-secondary Set per-role required shift counts
                .row.g-2#roleRequirementList

                hr
                h6.d-flex.justify-content-between.align-items-center.mb-2
                    span Participant overrides
                    button.btn.btn-sm.btn-outline-info(type="button" data-add-override)
                        i.bi.bi-plus-lg.me-1
                        | Add override
                p.text-secondary.small.mb-2
                    | Specify event participant-specific required shifts and optional role-scoped overrides.
                    |  Only registered participants are eligible for overrides.
                .override-list-scroll#overrideList

                .d-flex.flex-wrap.justify-content-end.align-items-center.gap-2.border-top.border-secondary-subtle.mt-3.pt-3
                    small.text-secondary.me-auto Changes are only applied after saving.
                    button.btn.btn-success(type="button" data-requirements-save)
                        i.bi.bi-save.me-1
                        | Save requirement settings

    hr
    h6.d-flex.justify-content-between.align-items-center.mt-3
        span
            span.badge.bg-light.text-dark.me-2 Step 2
            | Check coverage
        small.text-secondary Assignment, attendance, role, and requirement status

    +participantStatus({
        id: 'requirement-participant-status',
        items: [],
        assignmentMode: data.plan.assignmentMode || 'FREE',
        controls: true
    })

// Step 3: Recommendations
if permData.entity.has('MANAGE_ASSIGNMENTS') && data.plan.eventId
    hr
    .mb-3
        span.badge.bg-light.text-dark.me-2 Step 3
        span.fw-semibold Generate & apply suggestions

    .card.text-bg-dark.border.border-secondary-subtle#recommendationPanel
        .card-header.d-flex.justify-content-between.align-items-center
            span.d-flex.align-items-center.gap-2
                i.bi.bi-magic.me-1
                span Assignment recommendations
            .d-flex.gap-2
                button.btn.btn-sm.btn-outline-secondary(type="button" data-recommendations-refresh)
                    i.bi.bi-arrow-clockwise.me-1
                    | Reload
                button.btn.btn-sm.btn-outline-primary(
                    type="button"
                    data-recommendations-auto
                    disabled=data.plan.assignmentMode === 'FREE'
                    title=data.plan.assignmentMode === 'FREE' ? 'Automatic recommendations are disabled in free assignment mode' : ''
                )
                    i.bi.bi-stars.me-1
                    | Auto-generate
                button.btn.btn-sm.btn-primary(type="button" data-recommendations-apply)
                    i.bi.bi-save.me-1
                    | Save changes
        .card-body
            p.text-secondary.small
                | Recommendations fill participant capacity only. Automatic reassignments can move existing assignments without named roles; named roles remain manual.
            .d-flex.justify-content-between.align-items-center.mb-2
                p.text-secondary.small.mb-0
                    | Review recommendations visually in the schedule below.
                    |  Approve, reject, stage swaps or unassignments, then click "Save changes" to apply approved operations.
                small#recommendationSummaryStats.text-secondary
                    | No recommendations loaded.
            .alert.alert-info.py-2.px-3.d-none(role="alert" data-recommendations-alert)
                i.bi.bi-info-circle.me-2
                span

            // Enhanced schedule-based recommendations view
            #recommendationScheduleView
                include ./recommendations-schedule
