//- views/dashboard.pug  – überarbeitetes User-Dashboard
extends ../layout
//- Overview cards use the same archive commands as detail pages; include their mixins explicitly here.
include ../modules/module_entity_archive

block meta
    title My Dashboard | Surveyor

block title
    h1.card-header.text-center
        if data.admin_flag
            i.bi.bi-patch-check-fill.me-2
                | Your managed entities
        else
            i.bi.bi-house-door-fill.me-2
                | Welcome, #{profile.name}!

block content
    if data.participant
        h2.text-center
            i.bi.bi-clipboard-check.me-2
            | Your participation
        p.text-center Here are all entities that you participate in. Open the respective section to see and access them.
        hr
        .accordion.accordion-dark#participationLists
            //- The controller supplies bounded main/hidden pages for the active profile's membership.
            +pagedEntityOverview('sec-parts', 'Your participation', 'bi-clipboard-check', data.participant, "participationLists")

    if data.owner
        h2.text-center
            i.bi.bi-shield-check.me-2
            | Administrable entities
        p.text-center These are the entities that you either own or are an admin to. Open the respective section to see and access them.
        hr
        .accordion.accordion-dark#entityLists
            //- Owner-only actions stay inside the common card; collection membership grants no new action.
            +pagedEntityOverview('sec-own-parts', 'Administrable entities', 'bi-shield-check', data.owner, "entityLists")

block scripts
    //- A single binding covers both collections; successful changes reload both appearances of an entity.
    +entityArchiveScripts()
    script(type="module" src="/js/user-dashboard.gen.js")
