{
  "name": "surveyor",
  "version": "0.2.3",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "pretest": "npm run generate",
    "pretest:integration": "npm run generate",
    "pretest:ci": "npm run generate",
    "run": "node dist/server.js",
    "server:dev": "cross-env NODE_ENV=development SURVEYOR_FRONTEND_DEV=1 nodemon --watch src --watch .generated/frontend-ready.json --ignore src/frontend --ignore src/public --ignore src/types --ignore src/locales --ignore src/modules/localization/generated --ignore src/modules/lib/permissions.ts --ignore src/modules/invoice/locales/en.ts --ext ts,js,json --delay 500ms --exec \"ts-node --project tsconfig.server.json src/server.ts\"",
    "server": "npm run build && concurrently \"npm run server:dev\" \"npm run server:frontend\"",
    "typeorm": "ts-node --project tsconfig.server.json scripts/runMigration.ts",
    "typeorm:drop": "npm run typeorm -- schema:drop migrationDataSource.ts",
    "typeorm:sync": "npm run typeorm -- schema:sync migrationDataSource.ts",
    "typeorm:migrate": "npm run typeorm -- migration:run migrationDataSource.ts",
    "typeorm:reset-db": "npm run generate:db-index && npm run typeorm:drop && npm run typeorm:sync && npm run typeorm:migrate",
    "generate:db-index": "ts-node --project tsconfig.server.json scripts/genTypeormIdx.ts",
    "generate": "npm run generate:db-index && npm run generate:api && npm run generate:locales",
    "docs:fingerprint": "node scripts/check-documentation.mjs --fingerprint",
    "docs:check:help": "node scripts/report-documentation.mjs --help-only",
    "docs:check": "node scripts/report-documentation.mjs",
    "docs:check:strict": "node scripts/report-documentation.mjs --strict",
    "check:development": "node scripts/check-development-policy.mjs",
    "test:development-policy": "node --test scripts/tests/development-policy-check.test.mjs",
    "copy:assets": "cpx \"src/public/img/**/*\" dist/public/img && cpx \"src/public/style/print.css\" dist/public/style",
    "copy:views": "cpx \"src/views/**/*\" dist/views",
    "copy": "npm run copy:assets && npm run copy:views",
    "build:clean": "node scripts/clean-build.mjs",
    "build:print": "sass src/public/style/print.sass:src/public/style/print.css --no-source-map",
    "build:server": "npm run generate && tsc --project tsconfig.server.json && npm run copy:contracts",
    "build": "npm run build:clean && npm run build:server && npm run build:frontend && npm run build:print && npm run copy",
    "test": "vitest run --config vitest.config.mts",
    "test:quick": "vitest run --config vitest.config.mts --project database-free",
    "test:unit": "vitest run --config vitest.config.mts tests/unit",
    "test:integration": "vitest run --config vitest.config.mts tests/integration",
    "test:frontend": "vitest run --config vitest.config.mts tests/frontend",
    "pretest:frontend:browser": "npm run build",
    "test:frontend:browser": "playwright test --config playwright.frontend.config.ts",
    "test:integration:browser": "playwright test --config playwright.integration.config.ts",
    "e2e:prepare": "ts-node --project tsconfig.server.json scripts/e2e.db.init.ts",
    "e2e:init": "npm run e2e:prepare && npm run run",
    "e2e": "playwright test",
    "test:all": "npm test && npm run build && npm run test:frontend:browser --ignore-scripts && npm run e2e",
    "test:ci": "vitest run --config vitest.config.mts --coverage --reporter=default --reporter=junit --outputFile.junit=artifacts/junit-vitest.xml",
    "docs:test:tooling": "node scripts/report-documentation.mjs --tool-tests",
    "docs:test:content": "node scripts/report-documentation.mjs --content",
    "docs:test:browser": "node scripts/report-documentation.mjs --browser",
    "generate:api": "node scripts/generate-api.mjs",
    "generate:locales": "node scripts/generate-locales.mjs",
    "prepare:frontend": "npm run generate:api && npm run generate:locales",
    "copy:contracts": "cpx \".generated/api/v1/{openapi.json,operations.json,server.cjs}\" dist/api-contracts",
    "build:frontend": "npm run typecheck:frontend && cross-env NODE_ENV=production vite build --config vite.config.mts && cross-env NODE_ENV=production vite build --config vite.config.mts --ssr src/frontend/app/entry-server.ts",
    "pretest:quick": "npm run generate",
    "pretest:unit": "npm run generate",
    "pretest:frontend": "npm run generate",
    "pretypecheck:frontend": "npm run prepare:frontend",
    "pretypecheck:tests": "npm run generate",
    "typecheck:tests": "vue-tsc --project tsconfig.test.json --noEmit",
    "typecheck:frontend": "vue-tsc --project tsconfig.frontend.json --noEmit && vue-tsc --project tsconfig.frontend-ssr.json --noEmit",
    "server:frontend": "node scripts/watch-frontend-inputs.mjs"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "connect-typeorm": {
      "typeorm": "$typeorm"
    }
  },
  "dependencies": {
    "@tanstack/vue-query": "5.104.5",
    "@vue/server-renderer": "3.5.44",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "1.13.2",
    "connect-typeorm": "^2.0.0",
    "cookie-parser": "^1.4.7",
    "csv-reader": "^1.0.12",
    "date-fns": "^4.4.0",
    "debug": "^4.4.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-flash": "^0.0.2",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "http-errors": "^2.0.1",
    "i18next": "26.5.11",
    "i18next-vue": "5.4.0",
    "joi": "^18.3.0",
    "marked": "^18.1.1",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.1",
    "openapi-fetch": "0.17.0",
    "openid-client": "^6.8.8",
    "pdfmake": "^0.3.13",
    "pug": "^3.0.4",
    "reka-ui": "2.11.0",
    "typeorm": "^1.1.2",
    "uuid": "^14.0.3",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@redocly/cli": "2.71.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-flash": "^0.0.5",
    "@types/express-session": "^1.19.0",
    "@types/jsdom": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "^0.3.3",
    "@types/pug": "^2.0.10",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "2.5.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "concurrently": "^10.0.6",
    "cpx2": "^9.0.3",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "happy-dom": "21.0.4",
    "nodemon": "^3.1.14",
    "openapi-typescript": "7.13.0",
    "sass": "^1.106.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "3.3.13",
    "yaml": "2.9.1"
  }
}
