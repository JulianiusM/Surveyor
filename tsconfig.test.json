{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "types": [
      "@playwright/test",
      "node",
      "jquery",
      "vite/client"
    ]
  },
  "include": [
    "src/types/**/*.d.ts",
    "playwright.frontend.config.ts",
    "playwright.integration.config.ts",
    "tests/**/*.ts",
    "tests/**/*.d.ts"
  ]
}
